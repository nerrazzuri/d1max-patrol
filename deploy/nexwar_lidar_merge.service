[Unit]
Description=D1 Max 前后雷达合并(后雷达换进前雷达系、拼成 /nexwar/merged_lidar 给定位器、建图预览;W09i)
# 装机脚本只装、不 enable:后雷达外参(/etc/nexwar/lidars.json)在真机上标过、W09i 的真机项验过之前不起。
# 起用:sudo systemctl enable --now nexwar_lidar_merge,再在 /etc/nexwar/env 里给定位器
# NEXWAR_LOC_ARGS=--lidar-topic /nexwar/merged_lidar。外参没标过它只转发前雷达(不拼)。
After=network-online.target nexwar_zenohd.service
Wants=network-online.target
StartLimitIntervalSec=0
# W42:正在清机(解绑 = 恢复出厂,半路断电了)就不起,等配网服务清完
ConditionPathExists=!/etc/nexwar/bind/wiping

[Service]
Type=simple
User=robot
WorkingDirectory=-/opt/nexwar/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nexwar/env
ExecStart=/opt/nexwar/current/deploy/nexwar_lidar_merge_start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
