#!/bin/bash
# d1max-privileged —— robot 通过 sudo 白名单能跑的**唯一** root 命令(W01b)。
#
# 为什么有它:服务以 User=robot 跑,而 OTA 升级要写 /etc/systemd/system 的
# 单元、daemon-reload、restart/reboot,这几件都要 root。与其给 robot 一条
# 宽的 sudo 规则,不如给它一个只会做这四件事、每件都把输入校验过的脚本。
#
# 装在哪:/usr/local/sbin/d1max-privileged,root:root 0755(install.sh 5/7)。
# **不能放 /opt/d1max/bin** —— 那棵树归 robot;sudo 白名单指着 robot 可写的
# 脚本,等于把 root 送给 robot。同理,这个脚本**不随 OTA 更新自己**:改它要
# 重跑 install.sh。所以它必须小而稳。
#
# 子命令:
#   check                 探一下 sudo 通不通。退 0。
#   install-unit <版本名>  把 /opt/d1max/releases/<版本名>/deploy/d1max-patrol.service
#                         校验后装到 /etc/systemd/system/,daemon-reload。
#                         打印 installed / unchanged。
#   install-agent-unit <版本名>
#                         同上,装的是这一版带的 d1max-agent.service(W00c5d:站点下发版本,
#                         代理自己切;同一道校验,只多认 [Unit] 里那一句
#                         ConditionPathExists=/etc/d1max/registration.json)。
#                         代理重启不要 root:单元是 Restart=always,代理自己好好退出就行。
#   restart               用 systemd-run 起临时单元跑 /usr/local/sbin/d1max-restart-now
#                         (stop → 搬槽内数据 → start)。那个脚本不在 sudo 白名单里,
#                         robot 直接跑不了;放这儿的话 stop 会在服务自己的 cgroup 里
#                         把助手一起杀掉。这里只等 systemd-run 把任务排进去。
#   reboot                systemctl reboot。
#
# 开发机测试(非 root):必须显式给 --root <dir> --dest <file> --no-systemctl(可再给
# --restart-now <file> 指一个假的内部入口);root 下这几个参数一律拒绝 —— 真机上不
# 接受任何改路径的口子。
set -euo pipefail

UNIT_NAME=d1max-patrol.service
AGENT_UNIT_NAME=d1max-agent.service
RELEASE_ROOT=/opt/d1max
DEST=/etc/systemd/system/$UNIT_NAME
AGENT_DEST=/etc/systemd/system/$AGENT_UNIT_NAME
RESTART_NOW=/usr/local/sbin/d1max-restart-now
RUN_USER=robot
DATA_ROOT=/var/lib/d1max
SYSTEMCTL=systemctl
TEST_MODE=0

die()  { printf 'd1max-privileged: %s\n' "$*" >&2; exit 1; }
usage() {
  printf '用法: d1max-privileged check | install-unit <版本名> | install-agent-unit <版本名> | restart | reboot\n' >&2
  exit 64
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --root)  [[ $# -ge 2 ]] || usage; RELEASE_ROOT=$2; TEST_MODE=1; shift 2 ;;
    --dest)  [[ $# -ge 2 ]] || usage; DEST=$2; AGENT_DEST=$2; TEST_MODE=1; shift 2 ;;
    --no-systemctl) SYSTEMCTL=:; TEST_MODE=1; shift ;;
    --restart-now) [[ $# -ge 2 ]] || usage; RESTART_NOW=$2; TEST_MODE=1; shift 2 ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done

if [[ $EUID -eq 0 && $TEST_MODE -eq 1 ]]; then
  die "root 下不接受 --root/--dest/--no-systemctl:真机上路径是写死的"
fi
if [[ $EUID -ne 0 && $TEST_MODE -eq 0 ]]; then
  die "不是 root。真机上用 sudo;开发机测试要显式给 --root --dest --no-systemctl"
fi
if [[ $TEST_MODE -eq 1 && ( $SYSTEMCTL != ":" || -z $DEST || $RELEASE_ROOT == /opt/d1max ) ]]; then
  die "测试模式要 --root、--dest、--no-systemctl 三个一起给"
fi

# --------------------------------------------------------------- 单元校验
# 这是提权面的护栏。robot 已经能以 robot 跑任意代码,护栏要挡的是「借单元
# 变成 root」:User= 改掉或放错段、ExecStart 指到别处、ExecStartPre=+ 以 root
# 跑、EnvironmentFile 读别的文件、LD_PRELOAD 之类的环境变量、能力集……
# **按段校验**:systemd 对放错段的键只记一句 ignoring —— `[Unit]` 里的
# User=robot 等于没写,服务以 root 起。不在该段白名单里的键一律拒。
# **拒绝续行**:以反斜杠结尾的行 systemd 会跟下一行拼成一个值,校验器按物理
# 行看到的 User=robot 会被并进上一行;真单元里没有续行,见到就拒。
# **拒的时候只说行号和键,不回显内容**:源可以被换成指向 root 才读得到的
# 文件的链,stderr 会原样透传到 HTTP 409 的 body 里。
UNIT_KEYS=" Description After Wants StartLimitIntervalSec ConditionPathExists "
SERVICE_KEYS=" Type User ExecStart ExecStartPre Restart RestartSec Environment EnvironmentFile WorkingDirectory "
INSTALL_KEYS=" WantedBy "

validate_unit() {
  local file=$1 line key value n=0 saw_user=0 section="" allowed=""
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [[ -z ${line//[[:space:]]/} ]] && continue
    [[ ${line#"${line%%[![:space:]]*}"} == \#* ]] && continue
    [[ $line == *\\ ]] && die "第 $n 行:不许用反斜杠续行"
    case "$line" in
      "[Unit]")    section=Unit;    allowed=$UNIT_KEYS;    continue ;;
      "[Service]") section=Service; allowed=$SERVICE_KEYS; continue ;;
      "[Install]") section=Install; allowed=$INSTALL_KEYS; continue ;;
      \[*) die "第 $n 行:不认识的段(只许 [Unit]/[Service]/[Install])" ;;
    esac
    [[ -n $section ]] || die "第 $n 行:段头之前不许有键"
    [[ $line == *=* ]] || die "第 $n 行:不是 键=值 也不是段头"
    key=${line%%=*}
    value=${line#*=}
    [[ $allowed == *" $key "* ]] || die "第 $n 行:[$section] 段里不许出现 $key="
    case "$key" in
      After|Wants)
        # 依赖值也是护栏:Wants=debug-shell.service 会拉起一个挂在 tty9 的无认证
        # root shell,emergency.service 在锁了 root 口令的机器上也直接给 shell。
        local dep
        for dep in $value; do
          [[ $dep == network-online.target || $dep == network.target ]] \
            || die "第 $n 行:$key 只许 network-online.target / network.target"
        done ;;
      User)
        [[ $value == "$RUN_USER" ]] || die "第 $n 行:User 只能是 $RUN_USER"
        saw_user=1 ;;
      ConditionPathExists)
        # 代理单元那一句(W00c5d):只许这一个固定路径 —— 条件只决定起不起,不给别的口子。
        [[ $value == "/etc/d1max/registration.json" ]] \
          || die "第 $n 行:ConditionPathExists 只许 /etc/d1max/registration.json" ;;
      ExecStart|ExecStartPre)
        case "$value" in
          [+!:@]*) die "第 $n 行:$key 不许用 +/!/:/@ 前缀(那是以 root 跑)" ;;
        esac
        value=${value#-}
        [[ $value == *..* ]] && die "第 $n 行:$key 里不许有 .."
        [[ $value == /opt/d1max/* ]] || die "第 $n 行:$key 只能指向 /opt/d1max/ 底下" ;;
      EnvironmentFile)
        [[ $value == "-/etc/d1max/env" ]] || die "第 $n 行:EnvironmentFile 只许 -/etc/d1max/env" ;;
      Environment)
        # 一行只许一个赋值,值里不许有空白和引号 —— 不然 D1MAX_A=1 后面能跟
        # LD_PRELOAD=/x.so。
        [[ $value =~ ^D1MAX_[A-Z0-9_]+=[^[:space:]\"\']*$ || $value == "PYTHONUNBUFFERED=1" ]] \
          || die "第 $n 行:Environment 只许一个 D1MAX_*=值 或 PYTHONUNBUFFERED=1" ;;
      WorkingDirectory)
        value=${value#-}
        [[ $value == *..* ]] && die "第 $n 行:WorkingDirectory 里不许有 .."
        [[ $value == /opt/d1max/* ]] || die "第 $n 行:WorkingDirectory 只能在 /opt/d1max/ 底下" ;;
    esac
  done < "$file"
  [[ $saw_user -eq 1 ]] || die "[Service] 段里没有 User=$RUN_USER —— 没有它的单元以 root 跑"
}

TMP=
cleanup() { if [[ -n ${TMP:-} ]]; then rm -f "$TMP"; fi; }
trap cleanup EXIT

install_unit() {
  # $1 版本名;$2 单元文件名(d1max-patrol.service / d1max-agent.service);$3 装到哪。
  local name=${1:-} unit=${2:-$UNIT_NAME} dest=${3:-$DEST} src size
  [[ $name =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{6,12}$ ]] \
    || die "版本名不合规:${name:-(空)}"
  src=$RELEASE_ROOT/releases/$name/deploy/$unit
  [[ -e $src || -L $src ]] || die "源不存在:$src(这一版的包没带 deploy/?)"
  # **只打开源一次:先 cp -P 进 root 拥有的目标目录,之后一切只看那份拷贝。**
  # 源在 robot 可写的槽里,校验源、再拷源之间有窗口,robot 可以在窗口里把文件
  # 换掉或换成指向 /etc/shadow 的链(TOCTOU)。-P 不跟链:拷出来还是链就拒。
  # 拷贝落在 /etc/systemd/system 底下,robot 碰不到;校验的和装进去的是同一份。
  TMP=$(mktemp "$dest.XXXXXX")
  rm -f "$TMP"
  # 源可以是 robot 建的 FIFO:没有超时的话 root 的 cp 会永远阻塞在 open 上。
  timeout 5 cp -P -- "$src" "$TMP" || die "源拷不出来(不是普通文件,或 5 s 内读不完)"
  [[ -L $TMP ]] && die "源是符号链接,拒绝"
  [[ -f $TMP ]] || die "源不是普通文件,拒绝"
  size=$(stat -c %s "$TMP")
  [[ $size -le 65536 ]] || die "源太大($size 字节),不像一份单元文件"
  # **NUL 与其他控制字符一律拒。** bash 的 read 会静默丢掉 NUL,校验器看到的
  # User=robot 在 systemd 眼里是 "Us" 和 "er=robot" 两行垃圾 —— 装进去的单元
  # 没有 User=,以 root 起。只放行 \t \n \r;UTF-8 中文注释(0x80–0xFF)不受影响。
  if LC_ALL=C grep -q -a -P '[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]' "$TMP"; then
    die "单元里有 NUL 或控制字符,拒绝"
  fi
  validate_unit "$TMP"
  chmod 0644 "$TMP"
  if [[ -f $dest ]] && cmp -s "$TMP" "$dest"; then
    echo unchanged
    return 0
  fi
  mv -f "$TMP" "$dest"
  TMP=
  # 单元已经换上了;reload 失败要说清楚是这个状态,不是「没装上」。
  $SYSTEMCTL daemon-reload || die "单元已写入 $dest,但 daemon-reload 失败 —— 手工 systemctl daemon-reload"
  echo installed
}

# --------------------------------------------------------------- 重启
# **restart 不能在自己的 cgroup 里停自己。** 服务起的 sudo/bash 都还在
# d1max-patrol.service 的 cgroup 里;`systemctl stop` 按 KillMode=control-group 会把
# 它们一起杀掉。所以真正的 stop → migrate → start 在 /usr/local/sbin/d1max-restart-now
# 里,由 systemd-run 起在一个临时单元(systemd 自己的 cgroup 树)里跑;这里只等
# systemd-run 把任务排进去 —— 排进去了才退 0,排不进去(systemd-run 不在、单元名
# 冲突、systemd 拒绝)退非零,app 那边据此决定回不回「已重启」。
#
# **排队之前先核对内部入口在且可执行。** 临时单元默认 Type=simple:fork 成功就算
# 启动成功,execve 之前 systemd-run 就退 0 —— 内部脚本被挪走了它照样退 0,app 回
# 「已重启」,服务却没动(外部审核阻断项)。/usr/local/sbin 归 root、脚本 0700
# root:root,robot 在核对与执行之间换不了它,这个预检没有单元源文件那种 TOCTOU。
do_restart() {
  [[ -f $RESTART_NOW && -x $RESTART_NOW ]] \
    || die "内部重启入口不存在或不可执行:$RESTART_NOW —— 重跑 deploy/install.sh"
  if [[ $TEST_MODE -eq 1 ]]; then
    echo "would: systemd-run --collect -- $RESTART_NOW"
    return 0
  fi
  systemd-run --quiet --collect --unit="d1max-restart-$(date +%s)-$$" \
    --description="d1max OTA 重启:stop → migrate-data → start" \
    -- "$RESTART_NOW"
}

# **参数个数严查。** sudoers 那一行不限参数,参数安全全由这里扛:每个子命令
# 只接受它该有的那几个,多一个少一个都退 64。
cmd=${1:-}
[[ -n $cmd ]] || usage
shift
case "$cmd" in
  check)        [[ $# -eq 0 ]] || usage; exit 0 ;;
  install-unit) [[ $# -eq 1 ]] || usage; install_unit "$1" "$UNIT_NAME" "$DEST" ;;
  install-agent-unit)
                [[ $# -eq 1 ]] || usage; install_unit "$1" "$AGENT_UNIT_NAME" "$AGENT_DEST" ;;
  restart)      [[ $# -eq 0 ]] || usage; do_restart ;;
  reboot)       [[ $# -eq 0 ]] || usage
                if [[ $TEST_MODE -eq 1 ]]; then echo "would: reboot"; else $SYSTEMCTL reboot; fi ;;
  *)            usage ;;
esac
