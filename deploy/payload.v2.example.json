{
  "relay": {
    "port": "/dev/serial/by-id/<USB 转 RS485 的名字>",
    "baud": 9600,
    "slave": 1,
    "coils": {"spot_l": 0, "spot_r": 1, "siren": 2, "beacon": 3}
  },
  "spotlight": {"left": "spot_l", "right": "spot_r"},
  "strobe": {"colors": {"red": "beacon"}, "default": "red", "blink_s": 0},
  "siren": {"coil": "siren", "clip": "siren"},
  "audio": {
    "device": "plughw:CARD=rockchipes8388",
    "clips_dir": "/var/lib/d1max/clips",
    "mute": {"chip": "gpiochip1", "line": -1, "mute_level": "high"},
    "amp_lead_s": 0.2,
    "amp_idle_s": 15
  }
}
