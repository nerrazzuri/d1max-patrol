[Unit]
Description=D1 Max 机器人代理(robot-agent)
After=network-online.target
Wants=network-online.target
# 不限起动次数;配合 Restart=always/RestartSec=5。键属于 [Unit] 段(W01c 的教训)。
StartLimitIntervalSec=0
# 没有站点签发的注册文件就不起(W00c 才签发):不然 enable 之后每 5 秒崩一次、日志刷屏。
ConditionPathExists=/etc/d1max/registration.json

[Service]
Type=simple
User=robot
# 指着 current 链,不指任何一版 —— 双槽能换、能退的全部原因。
WorkingDirectory=-/opt/d1max/current
Environment=D1MAX_RELEASE_ROOT=/opt/d1max
Environment=D1MAX_DATA_ROOT=/var/lib/d1max
# W00c5d(决策 8):运行记录落发件箱、边跑边传、站点确认即删。发件箱可以指到临时硬盘:
# 在 /etc/d1max/env 里写 D1MAX_OUTBOX=/mnt/<临时盘>/outbox(下面这行是缺省,env 文件覆盖它),
# 再写 D1MAX_OUTBOX_MOUNT=/mnt/<临时盘>:临时盘没挂上代理就不起,不会悄悄写到系统盘上。
Environment=D1MAX_OUTBOX=/var/lib/d1max/outbox
Environment=PYTHONUNBUFFERED=1
# 站点地址、地图、原点、适配器这些现场值从 env 文件来(W00c 装站点时填);证书包由站点
# `d1max-site enroll` 签发,拷到 /etc/d1max/tls/(W00c1)。要填哪几个见启动脚本的注释。
EnvironmentFile=-/etc/d1max/env
# W00c5d:站点下发版本、代理自己切。新版起不来的话,每次重起前守卫数一次在途标记,
# 数够就把 current 指回上一版。
ExecStartPre=-/opt/d1max/bin/python -m d1max_patrol.cli release boot-guard
# **启动参数在这一版带的启动脚本里,不在这儿**(W00c5d 第三部分内部评审 B1):单元装一次不再换,
# 退回上一版时参数跟着代码一起回来。
# 起用时在 /etc/d1max/env 里把 D1MAX_HAL 改成 d1max(W00d 真机验收过了才改);
# 旁路进程同一时刻只该有一个 Python 在开车(老服务 d1max-patrol.service 由装机脚本清掉)。
ExecStart=/opt/d1max/current/deploy/d1max-agent-start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
