#!/bin/bash
# d1max-restart-now —— OTA 重启的**内部**入口:stop → 搬槽内数据 → start(W01b)。
#
# **不在 sudo 白名单里,robot 没有任何路能以 root 跑它。** 它只由
# /usr/local/sbin/d1max-privileged 的 restart 子命令经 systemd-run 起在一个临时
# 单元里调 —— 那是 systemd 自己的 cgroup 树,不是 d1max-patrol.service 的。
# 要是把这三步放在服务自己的 cgroup 里跑(服务 Popen 起的任何进程都在那儿),
# `systemctl stop` 按 KillMode=control-group 会把跑这三步的进程一起杀掉,migrate
# 和 start 永远跑不到,而显式 stop 不触发 Restart=always —— 服务就停着不起。
# 外部审核指出:原来它是助手的一个子命令,sudoers 放行整个助手,robot 直接
# `sudo helper restart-now` 就能重新踩进这个坑。所以拆成独立脚本,0700 root:root。
#
# 装在哪:/usr/local/sbin/d1max-restart-now(install.sh 5/7),不随 OTA 更新自己。
set -euo pipefail

UNIT_NAME=d1max-patrol.service
RELEASE_ROOT=/opt/d1max
RUN_USER=robot
DATA_ROOT=/var/lib/d1max

if [[ $EUID -ne 0 ]]; then
  printf 'd1max-restart-now: 只能以 root 跑,而且只由 d1max-privileged restart 经 systemd-run 调\n' >&2
  exit 1
fi
if [[ $# -ne 0 ]]; then
  printf 'd1max-restart-now: 不接受参数\n' >&2
  exit 64
fi

systemctl stop "$UNIT_NAME" || true
if systemctl is-active --quiet "$UNIT_NAME"; then
  printf '  !! 服务停不掉,跳过数据迁移(搬的前提是没人在往槽里写)\n' >&2
else
  # 跟 install.sh 7/7 一模一样:以服务用户搬,拷出来的文件才归 robot。
  runuser -u "$RUN_USER" -- env D1MAX_RELEASE_ROOT="$RELEASE_ROOT" D1MAX_DATA_ROOT="$DATA_ROOT" \
    "$RELEASE_ROOT/bin/python" -m d1max_patrol.cli release migrate-data \
    || printf '  !! 槽内数据迁移没成功;没搬动的还在原槽里、原名不变,prune 不会删它们\n' >&2
fi
systemctl start "$UNIT_NAME"
