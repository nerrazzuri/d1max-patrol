[Unit]
Description=D1 Max 开机守卫:连着两次没坐实就退回上一版
# **必须在服务之前。** 反过来的话,守卫永远在坏版本已经失败之后才跑。
Before=d1max-patrol.service
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=D1MAX_RELEASE_ROOT=/opt/d1max
# 跟服务单元同一个来源、同一份文件。守卫本身不比对 SN,但让两个单元
# 保持同一套环境变量约定,免得将来有人往守卫里加了一条读 D1MAX_SN 的
# 逻辑,却发现这份文件没被引用过。
EnvironmentFile=-/etc/d1max/env
# **这个 python 是根下的,不是 current 下的** —— 守卫必须跟版本无关:
# 一个坏到解释器都装歪了的版本,不该把自己的救生索也带坏。
ExecStart=/opt/d1max/bin/python -m d1max_patrol.cli release boot-guard
# 守卫自己挂了也放行。安全网不该比它防的问题更危险。
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
