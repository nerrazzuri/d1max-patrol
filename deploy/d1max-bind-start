#!/usr/bin/env bash
# 配网服务(W42,docs/W42-机器人绑定-设计.md)。systemd 用;参数在这一版带的脚本里,退回上一版时跟着回来。
#   D1MAX_BIND_HOST=<3588 在路由器 LAN1 上的地址>   只绑这个地址:热点那一侧的手机只碰得到它
#   D1MAX_ROUTER=<路由器>                            缺省 fake(G806w 那份等硬件答复,W42 §8)
set -euo pipefail
exec /opt/d1max/bin/python -m d1max_patrol.cli bind-serve \
  --host "${D1MAX_BIND_HOST:?/etc/d1max/env 里没有 D1MAX_BIND_HOST(3588 在路由器 LAN1 上的地址)}" \
  --router "${D1MAX_ROUTER:-fake}" \
  --outbox "${D1MAX_OUTBOX:-}"
