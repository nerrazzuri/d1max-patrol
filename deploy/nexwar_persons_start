#!/bin/sh
# nexwar_persons 的启动脚本(W24,人员检测节点)。跟 nexwar_obstacles_start 一个道理:启动参数归版本管,
# 单元只指着 /opt/nexwar/current/deploy/nexwar_persons_start。
#
# 检测节点跑在 **ROS 的系统 Python** 里(要 rclpy、sensor_msgs、numpy;检测模型要 onnxruntime 与 OpenCV
# —— 真机项,没装上就报 no_model,代理据此不判「人走了」)。代码用这个脚本所在那一版带的
# packages/localizer 与 packages/contract(按 PYTHONPATH 找,不进 venv)。雷达外参跟着代理正在用的图走,
# 结果经本机人员桥(/var/lib/nexwar/agent/persons.sock)给代理,截图存在 /var/lib/nexwar/agent/person-snapshots
# (代理存成归档传站点后删掉)。跟代理同一个账号(桥按账号认)。
#
# 现场值从 /etc/nexwar/env 来(单元的 EnvironmentFile):
#   NEXWAR_LOC_ROS_DOMAIN=24        相机、雷达话题在哪个 ROS domain(跟定位器一样)
#   NEXWAR_LOC_RMW=rmw_zenoh_cpp    中间件
#   NEXWAR_PERSONS_MODEL=/etc/nexwar/person.onnx  检测模型
#   NEXWAR_PERSONS_ARGS=其余参数(--fps、--hfov、--lens、--z-min、--z-max、--back-topic …)
#   NEXWAR_PERSONS_CONNECT=HOST:PORT  跨板(这块是厂家 Orin、代理在自带的 RK3588):经机器人内网 TCP 连代理的
#                 人员桥(就是那边的 NEXWAR_PERSONS_LISTEN);截图走桥、外参由代理推过来。共享密钥
#                 NEXWAR_PERSONS_KEY(缺省 /etc/nexwar/persons.key,跟代理那块板同一把)
set -eu
here=$(cd "$(dirname "$0")/.." && pwd -P)
set +u
. /opt/ros/humble/setup.sh
set -u
export ROS_DOMAIN_ID="${NEXWAR_LOC_ROS_DOMAIN:-24}"
export RMW_IMPLEMENTATION="${NEXWAR_LOC_RMW:-rmw_zenoh_cpp}"
# 不读 ~/.local:C40221 上 robot 账号的 ~/.local 里有一份 numpy 2.x(不是我们装的),盖住系统的
# numpy 1.21,系统的 OpenCV 一 import 就挂(2026-10-08)。onnxruntime 装在单独的目录里,经
# /etc/nexwar/env 的 PYTHONPATH 带进来(接在下面这两段后面),见装机清单「狗上的系统件」。
export PYTHONNOUSERSITE=1
# numpy 的线性代数库(OpenBLAS)缺省开跟核数一样多的线程:一帧里的小矩阵运算用不着,C40221 上
# 8 个线程各吃 23–35%,跟定位器抢 CPU(2026-10-08)。
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
export PYTHONPATH="$here/packages/localizer/src:$here/packages/contract/src${PYTHONPATH:+:$PYTHONPATH}"
# shellcheck disable=SC2086  # NEXWAR_PERSONS_ARGS 要按空白拆成几个参数
exec /usr/bin/python3 -m nexwar_localizer.persons \
  ${NEXWAR_PERSONS_CONNECT:+--connect} ${NEXWAR_PERSONS_CONNECT:+"$NEXWAR_PERSONS_CONNECT"} \
  ${NEXWAR_PERSONS_CONNECT:+--key} \
  ${NEXWAR_PERSONS_CONNECT:+"${NEXWAR_PERSONS_KEY:-/etc/nexwar/persons.key}"} \
  --socket /var/lib/nexwar/agent/persons.sock \
  --snapshots /var/lib/nexwar/agent/person-snapshots \
  --maps-dir /var/lib/nexwar/agent/maps \
  --model "${NEXWAR_PERSONS_MODEL:-/etc/nexwar/person.onnx}" \
  ${NEXWAR_PERSONS_ARGS:-}
