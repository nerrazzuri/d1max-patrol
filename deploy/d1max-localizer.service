[Unit]
Description=D1 Max 定位器(MOLA 只定位 + 定位质量,经本机定位桥给代理;W09b)
# 装机脚本只装、不 enable:真狗在 W09b 的真机项验过之前不起(代理也还用 --localizer anchor)。
# 起用:sudo systemctl enable --now d1max-localizer,再在 /etc/d1max/env 里写 D1MAX_LOCALIZER=bridge。
After=network-online.target d1max-agent.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# 跟代理同一个账号:本机定位桥按对端进程的账号认(W09a)。
User=robot
WorkingDirectory=-/opt/d1max/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/d1max/env
ExecStart=/opt/d1max/current/deploy/d1max-localizer-start
# MOLA 是它的子进程(同一个进程组以外的子孙也在这个 cgroup 里):停的时候一起停。
KillMode=control-group
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
