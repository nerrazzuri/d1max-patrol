SKIP_SUFFIXES = (".pyc", ".pyo", ".tmp", ".egg-info")
BUILD_OUTPUTS = frozenset({"build", "dist"})


def packed(rel: str) -> bool:
    parts = rel.split("/")
    built = (parts[0] in BUILD_OUTPUTS
             or (len(parts) > 2 and parts[0] == "packages" and parts[2] in BUILD_OUTPUTS)
             or (len(parts) > 1 and parts[0] == "motion" and parts[1] in BUILD_OUTPUTS))
    return not built and not any(p in SKIP_DIRS or p.endswith(SKIP_SUFFIXES) for p in parts)


class OpError(Exception):
    pass


Runner = Callable[[list[str], float], tuple[int, str]]


def run_cmd(argv: list[str], timeout: float = 120.0) -> tuple[int, str]:
    try:
        got = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, str(exc)
    return got.returncode, (got.stdout + got.stderr)[-4000:]


def read_nofollow(path: Path, *, limit: int, owner: int | None = None) -> bytes:
    """按 O_NOFOLLOW 打开普通文件读进内存;属主不对、太大、不是普通文件都拒。"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        raise OpError(f"打不开 {path.name}:{exc}") from exc
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OpError(f"{path.name} 不是普通文件")
        if owner is not None and st.st_uid != owner:
            raise OpError(f"{path.name} 的属主不对")
        if st.st_size > limit:
            raise OpError(f"{path.name} 过大")
        with os.fdopen(fd, "rb", closefd=False) as f:
            data = f.read()
        if len(data) > limit:
            raise OpError(f"{path.name} 过大")
        return data
    finally:
        os.close(fd)


def write_atomic(path: Path, data: bytes, *, mode: int, uid: int = 0, gid: int = 0) -> None:
    tmp = path.with_name(f".{path.name}.d1max-new")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise
    if os.geteuid() == 0:                       # 测试里不是 root:不改属主
        os.chown(tmp, uid, gid)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def tree_ok(root: Path, manifest: dict[str, Any], pubkey: Path,
            capture: frozenset[str] = frozenset()) -> dict[str, bytes]:
    """``root`` 这个包:签名对、内容指纹对。**一遍读完**:每个文件只读一次(``O_NOFOLLOW``),算指纹用的
    就是这份字节;``capture`` 里列的文件把这份字节交回去 —— 装的跟验的是同一份(外审 W55-1 第 5 条:先读
    单元、后算指纹的话,中间放进再删掉一个文件就能混进没签名的单元)。"""
    from d1max_contract import relsign
    try:
        relsign.verify(manifest, pubkey)
    except relsign.SignError as exc:
        raise OpError(f"发行签名不通过:{exc}") from exc
    digest = hashlib.sha256()
    got: dict[str, bytes] = {}
    files = sorted((p.relative_to(root).as_posix(), p) for p in root.rglob("*")
                   if p.is_file() and not p.is_symlink())
    for rel, p in files:
        if rel == "release.json" or not packed(rel):
            continue
        data = read_nofollow(p, limit=1 << 30)
        if rel in capture:
            got[rel] = data
        digest.update(rel.encode())
        digest.update(b"\0")
        digest.update(hashlib.sha256(data).hexdigest().encode())
        digest.update(b"\0")
    if digest.hexdigest() != manifest.get("content_sha256"):
        raise OpError("包的内容与签名的清单不匹配")
    return got


def prune_unsigned(root: Path) -> list[str]:
    """删掉不在签名范围里的(``packed`` 不收的、符号链接、除普通文件和目录以外的):root 装的时候
    只剩签过名的东西(外审 W55-1 第 3 条:``build/lib/*.pth`` 不算指纹却会被 setuptools 打进 wheel)。"""
    gone = []
    for dirpath, dirnames, filenames in os.walk(root, topdown=True, followlinks=False):
        here = Path(dirpath)
        for name in list(dirnames) + filenames:
            p = here / name
            rel = p.relative_to(root).as_posix()
            st = os.lstat(p)
            if stat.S_ISDIR(st.st_mode) and not stat.S_ISLNK(st.st_mode):
                if not packed(rel) and rel != "release.json":
                    shutil.rmtree(p)
                    gone.append(rel + "/")
                    dirnames.remove(name)
                continue
            if not stat.S_ISREG(st.st_mode) or (rel != "release.json" and not packed(rel)):
                p.unlink()
                gone.append(rel)
    return gone


def _dir_fd(path: Path) -> int:
    try:
        return os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise OpError(f"打不开目录 {path}:{exc}") from exc


def read_in_dir(dfd: int, name: str, *, limit: int) -> bytes | None:
    """目录描述符底下的一个普通文件(不跟链接);没有 → None。"""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise OpError(f"打不开 {name}:{exc}") from exc
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            raise OpError(f"{name} 不是普通文件或过大")
        with os.fdopen(fd, "rb", closefd=False) as f:
            data = f.read()
        if len(data) > limit:
            raise OpError(f"{name} 过大")
        return data
    finally:
        os.close(fd)


def write_in_dir(dfd: int, name: str, data: bytes, *, mode: int, uid: int, gid: int) -> None:
    """写进目录描述符底下:临时文件(O_EXCL、不跟链接)→ 改属主(fchown)→ 原子替换。原来那个是链接
    也只是换掉链接本身,不写到链接指的地方。"""
    tmp = f".{name}.d1max-{os.getpid()}"
    try:
        os.unlink(tmp, dir_fd=dfd)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=dfd)
    try:
        with os.fdopen(fd, "wb", closefd=False) as f:
            f.write(data)
            f.flush()
            os.fsync(fd)
        if os.geteuid() == 0:
            os.fchown(fd, uid, gid)
        os.fchmod(fd, mode)
    except BaseException:
        os.close(fd)
        os.unlink(tmp, dir_fd=dfd)
        raise
    os.close(fd)
    os.replace(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)


# ---------------------------------------------------------------- VPN(外审 W55-1 第 1、9 条)

VPN_NET = "172.29.70"                   # 同 d1max_site.vpn.SUBNET(测试核两边一致)
VPN_CHAIN = "D1MAX-VPN"
VPN_KINDS = ("robot", "phone", "engineer")
_B64KEY = re.compile(r"^[A-Za-z0-9+/]{43}=$")
_PEER_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")


def _host(addr: Any, *, prefix: int) -> int:
    if not isinstance(addr, str) or not addr.startswith(VPN_NET + ".") \
            or not addr.endswith(f"/{prefix}"):
        raise OpError(f"VPN 地址错误:{addr!r}")
    h = addr[len(VPN_NET) + 1:-len(f"/{prefix}")]
    if not h.isdigit() or not 1 <= int(h) <= 254 or str(int(h)) != h:
        raise OpError(f"VPN 地址错误:{addr!r}")
    return int(h)


def _key(v: Any, what: str) -> str:
    import base64
    if not isinstance(v, str) or not _B64KEY.fullmatch(v) or len(base64.b64decode(v)) != 32:
        raise OpError(f"VPN {what} 格式错误")
    return v


def check_vpn_doc(doc: Any) -> dict[str, Any]:
    """站点给的 VPN 数据逐项核:只认这几项,值都要是该有的样子(密钥是 32 字节 base64、地址在隧道网段里)。"""
    if not isinstance(doc, dict) or set(doc) != {"address", "port", "private", "peers"}:
        raise OpError("VPN 数据只认 address、port、private、peers")
    if _host(doc["address"], prefix=24) != 1:
        raise OpError("站点的 VPN 地址要是 .1")
    port = doc["port"]
    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
        raise OpError("VPN 端口错误")
    _key(doc["private"], "私钥")
    peers = doc["peers"]
    if not isinstance(peers, list) or len(peers) > 300:
        raise OpError("VPN peers 要是不超过 300 个的列表")
    hosts, keys = set(), set()
    for p in peers:
        if not isinstance(p, dict) or set(p) != {"name", "kind", "public", "psk", "address"}:
            raise OpError("VPN peer 只认 name、kind、public、psk、address")
        if not isinstance(p["name"], str) or not _PEER_NAME.fullmatch(p["name"]):
            raise OpError("VPN peer 名字错误")
        if p["kind"] not in VPN_KINDS:
            raise OpError("VPN peer 种类错误")
        _key(p["public"], "公钥")
        _key(p["psk"], "预共享密钥")
        h = _host(p["address"], prefix=32)
        if h == 1 or h in hosts or p["public"] in keys:
            raise OpError("VPN peer 地址或公钥重复")
        hosts.add(h)
        keys.add(p["public"])
    return doc


def vpn_rules(doc: dict[str, Any]) -> list[str]:
    """隧道里谁能连谁(同 ``d1max_site.vpn.VpnState._forward_rules``,测试核两边一致):只放行
    工程师 → 隧道里的 TCP 22,别的隧道内转发一律丢。规则单独一条链,起停整条清掉重建。"""
    eng = [p for p in doc["peers"] if p["kind"] == "engineer"]
    up = ["sysctl -q -w net.ipv4.conf.%i.forwarding=1",
          f"iptables -N {VPN_CHAIN} 2>/dev/null || true", f"iptables -F {VPN_CHAIN}",
          f"iptables -C FORWARD -i %i -j {VPN_CHAIN} 2>/dev/null || "
          f"iptables -I FORWARD -i %i -j {VPN_CHAIN}",
          f"iptables -A {VPN_CHAIN} -o %i -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"]
    up += [f"iptables -A {VPN_CHAIN} -o %i -s {p['address']} -p tcp --dport 22 -j ACCEPT"
           for p in eng]
    up += [f"iptables -A {VPN_CHAIN} -j DROP"]
    down = [f"iptables -D FORWARD -i %i -j {VPN_CHAIN} 2>/dev/null || true",
            f"iptables -F {VPN_CHAIN} 2>/dev/null || true",
            f"iptables -X {VPN_CHAIN} 2>/dev/null || true"]
    return [f"PostUp = {r}" for r in up] + [f"PostDown = {r}" for r in down]


def render_wg(doc: dict[str, Any]) -> str:
    out = ["# d1max 站点 VPN(W45、W55):由特权执行器生成,别手改", "[Interface]",
           f"Address = {doc['address']}", f"ListenPort = {doc['port']}",
           f"PrivateKey = {doc['private']}", *vpn_rules(doc), ""]
    for p in doc["peers"]:
        out += [f"# {p['kind']} {p['name']}", "[Peer]", f"PublicKey = {p['public']}",
                f"PresharedKey = {p['psk']}", f"AllowedIPs = {p['address']}", ""]
    return "\n".join(out)


def install_bind(files: dict[str, bytes], lib_dir: Path) -> bool:
    """配网服务的代码装进 ``<lib_dir>/bind/``(root 属主、只读):先在旁边建好整棵,再换名。``files`` 是
    包里路径 → 内容(已经验过签的那一份)。跟现在装着的一样就不动;回装没装。"""
    dst = lib_dir / "bind"
    if dst.is_dir() and all((dst / rel).is_file() and (dst / rel).read_bytes() == files[src]
                            for src, rel in BIND_FILES.items()):
        return False
    new, old = lib_dir / "bind.new", lib_dir / "bind.old"
    for d in (new, old):
        shutil.rmtree(d, ignore_errors=True)
    for src, rel in BIND_FILES.items():
        target = new / rel
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
        write_atomic(target, files[src], mode=0o755 if rel == "run.py" else 0o644)
    for d in [new, *(p for p in new.rglob("*") if p.is_dir())]:
        os.chmod(d, 0o755)
        if os.geteuid() == 0:
            os.chown(d, 0, 0)
    if dst.exists():
        os.rename(dst, old)
    os.rename(new, dst)
    shutil.rmtree(old, ignore_errors=True)
    return True


class Ops:
    def __init__(self, cfg: dict[str, Any], *, run: Runner = run_cmd,
                 etc: Path = Path("/etc"), systemd_dir: Path = Path("/etc/systemd/system")) -> None:
        self.cfg = cfg
        self.run = run
        self.etc = etc
        self.systemd_dir = systemd_dir
        self.profile = cfg["profile"]

    # ---------------------------------------------------------------- 公用
    def _sys(self, *argv: str, timeout: float = 120.0) -> str:
        rc, out = self.run(list(argv), timeout)
        if rc != 0:
            raise OpError(f"{' '.join(argv[:3])} 失败({rc}):{out.strip()[-300:]}")
        return out

    def _units(self) -> tuple[str, ...]:
        return ROBOT_UNITS if self.profile == "robot" else SITE_UNITS

    def _unit_arg(self, args: dict[str, Any]) -> str:
        u = args.get("unit")
        if u not in self._units():
            raise OpError(f"不在白名单里的服务:{u!r}")
        return str(u)

    def do(self, action: str, args: dict[str, Any]) -> dict[str, Any]:
        fn = ROBOT_ACTIONS.get(action) if self.profile == "robot" else SITE_ACTIONS.get(action)
        if fn is None:
            raise OpError(f"不认识的动作:{action!r}")
        return fn(self, args) or {}

    # ---------------------------------------------------------------- 机器人
    def restart(self, args: dict[str, Any]) -> dict[str, Any]:
        unit = self._unit_arg(args)
        if unit in ("d1max-agent", "d1max-site"):
            # 请求方自己:不等它起来(它一退,结果就没人读了)
            self._sys("systemctl", "--no-block", "restart", f"{unit}.service")
        else:
            self._sys("systemctl", "restart", f"{unit}.service", timeout=180)
        return {"unit": unit}

    def restart_all(self, args: dict[str, Any]) -> dict[str, Any]:
        """换版本以后:我们的服务里已启用或正在跑的,全重启;代理最后、不等。"""
        done = []
        for u in ROBOT_UNITS:
            rc_a, _ = self.run(["systemctl", "is-active", "--quiet", f"{u}.service"], 30)
            rc_e, _ = self.run(["systemctl", "is-enabled", "--quiet", f"{u}.service"], 30)
            if rc_a != 0 and rc_e != 0:
                continue
            if u == "d1max-agent":
                self._sys("systemctl", "--no-block", "restart", f"{u}.service")
            else:
                self.run(["systemctl", "restart", f"{u}.service"], 180)
            done.append(u)
        return {"restarted": done}

    def reboot(self, args: dict[str, Any]) -> dict[str, Any]:
        delay = args.get("delay_s", 5)
        if not isinstance(delay, int) or isinstance(delay, bool) or not 1 <= delay <= 60:
            raise OpError("delay_s 要 1–60")
        self._sys("systemd-run", f"--on-active={delay}", "--unit=d1max-reboot",
                  "/bin/systemctl", "reboot")
        return {"delay_s": delay}

    def timesync(self, args: dict[str, Any]) -> dict[str, Any]:
        if shutil.which("chronyc"):
            out = self._sys("chronyc", "-a", "makestep")
            return {"how": "chrony", "out": out.strip()[-200:]}
        self._sys("systemctl", "restart", "systemd-timesyncd.service")
        return {"how": "timesyncd"}

    def journal_vacuum(self, args: dict[str, Any]) -> dict[str, Any]:
        mb = args.get("max_mb", 200)
        if not isinstance(mb, int) or isinstance(mb, bool) or not 50 <= mb <= 2000:
            raise OpError("max_mb 要 50–2000")
        out = self._sys("journalctl", f"--vacuum-size={mb}M")
        return {"max_mb": mb, "out": out.strip()[-300:]}

    def cert_install(self, args: dict[str, Any]) -> dict[str, Any]:
        """代理放在 ``<data>/cert-new/`` 的新证书、新私钥、新登记文件换上(代理已核过公钥对得上私钥、
        链到站点 CA)。这里只再核格式,原来的留 ``.prev``,再重启代理。"""
        user = pwd.getpwnam(self.cfg["requester"])
        src = Path(self.cfg.get("data_root", "/var/lib/d1max")) / "cert-new"
        crt = read_nofollow(src / "robot.crt", limit=MAX_PEM, owner=user.pw_uid)
        key = read_nofollow(src / "robot.key", limit=MAX_PEM, owner=user.pw_uid)
        reg = read_nofollow(src / "registration.json", limit=MAX_PEM, owner=user.pw_uid)
        if b"-----BEGIN CERTIFICATE-----" not in crt or b"PRIVATE KEY-----" not in key:
            raise OpError("证书或私钥格式错误")
        try:
            json.loads(reg)
        except ValueError as exc:
            raise OpError("登记文件不是 JSON") from exc
        tls = self.etc / "d1max" / "tls"
        for name, data, mode, dest in (("robot.crt", crt, 0o644, tls / "robot.crt"),
                                       ("robot.key", key, 0o600, tls / "robot.key"),
                                       ("registration.json", reg, 0o644,
                                        self.etc / "d1max" / "registration.json")):
            if dest.is_file():
                st = dest.stat()
                shutil.copy2(dest, dest.with_name(dest.name + ".prev"))
                uid, gid = st.st_uid, st.st_gid
            else:
                uid, gid = user.pw_uid, user.pw_gid
            write_atomic(dest, data, mode=mode, uid=uid, gid=gid)
        self._sys("systemctl", "--no-block", "restart", "d1max-agent.service")
        return {"installed": ["robot.crt", "robot.key", "registration.json"]}

    def units_apply(self, args: dict[str, Any]) -> dict[str, Any]:
        """这一版包里带的服务单元(白名单里的)跟系统里的不一样就换上。包要过发行签名、内容指纹。"""
        name = args.get("release")
        if not isinstance(name, str) or not NAME_RE.fullmatch(name):
            raise OpError("版本名错误")
        root = Path(self.cfg.get("release_root", "/opt/d1max")) / "releases" / name
        pubkey = Path(self.cfg.get("pubkey", "/etc/d1max/release-pub.pem"))
        if not pubkey.is_file():
            raise OpError("机器人上没装发行公钥:服务单元不更新")
        manifest = json.loads(read_nofollow(root / "release.json", limit=MAX_REQ))
        want = frozenset(f"deploy/{u}.service" for u in ROBOT_UNITS) | frozenset(BIND_FILES)
        got = tree_ok(root, manifest, pubkey, want)
        units = {k: v for k, v in got.items() if k.endswith(".service")}
        changed = []
        for rel, data in units.items():
            dest = self.systemd_dir / Path(rel).name
            if dest.is_file() and dest.read_bytes() == data:
                continue
            write_atomic(dest, data, mode=0o644)
            changed.append(Path(rel).name)
        # 配网服务的代码(验过签的那一份)换进 root 独占目录;老包没带全就不动
        bind = False
        if all(k in got for k in BIND_FILES):
            bind = install_bind(got, Path(self.cfg.get("lib_dir", "/usr/local/lib/d1max")))
        if changed:
            self._sys("systemctl", "daemon-reload")
        if bind or "d1max-bind.service" in changed:
            self.run(["systemctl", "--no-block", "try-restart", "d1max-bind.service"], 30)
        return {"changed": changed, "bind": bind}

    # ---------------------------------------------------------------- 站点
    def _site(self) -> tuple[Path, Path, str]:
        return (Path(self.cfg.get("site_home", "/var/lib/d1max-site")),
                Path(self.cfg.get("site_venv", "/opt/d1max-site/venv")),
                self.cfg["requester"])

    def restart_site(self, args: dict[str, Any]) -> dict[str, Any]:
        self._sys("systemctl", "--no-block", "restart", "d1max-site.service")
        return {}

    def _healthy(self, wait_s: float) -> bool:
        """站点起来以后 ``wait_s`` 秒还在跑、没被 systemd 重起过。"""
        _, before = self.run(["systemctl", "show", "-p", "NRestarts", "--value", "d1max-site.service"], 30)
        time.sleep(wait_s)
        rc, _ = self.run(["systemctl", "is-active", "--quiet", "d1max-site.service"], 30)
        _, after = self.run(["systemctl", "show", "-p", "NRestarts", "--value", "d1max-site.service"], 30)
        return rc == 0 and before.strip() == after.strip()

    def _keep_vpn(self, aside: Path, home: Path, uid: int, gid: int) -> int:
        """恢复备份(外审 W55-1 第 12 条):备份里没有 VPN 状态,同一台主机恢复时把原来的
        ``vpn/`` 带过来(站点起来以后会照它重装 VPN 配置、收回到期的工程师)。原来的目录是站点账号的,
        一律不跟链接,只拷两层里的普通文件。回拷了几个文件。"""
        try:
            src = os.open(aside / "vpn", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError:
            return 0
        n = 0
        try:
            dst_dir = home / "vpn"
            if not dst_dir.exists():
                dst_dir.mkdir(mode=0o700)
                if os.geteuid() == 0:
                    os.chown(dst_dir, uid, gid)
            dst = _dir_fd(dst_dir)
            try:
                for name in os.listdir(src):
                    st = os.stat(name, dir_fd=src, follow_symlinks=False)
                    if stat.S_ISREG(st.st_mode):
                        data = read_in_dir(src, name, limit=MAX_REQ * 16)
                        if data is not None:
                            write_in_dir(dst, name, data, mode=0o600, uid=uid, gid=gid)
                            n += 1
                    elif stat.S_ISDIR(st.st_mode) and name == "peers":
                        sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                      dir_fd=src)
                        try:
                            if not (dst_dir / "peers").exists():
                                (dst_dir / "peers").mkdir(mode=0o700)
                                if os.geteuid() == 0:
                                    os.chown(dst_dir / "peers", uid, gid)
                            dsub = _dir_fd(dst_dir / "peers")
                            try:
                                for pn in os.listdir(sub):
                                    if not stat.S_ISREG(os.stat(pn, dir_fd=sub,
                                                                follow_symlinks=False).st_mode):
                                        continue
                                    data = read_in_dir(sub, pn, limit=MAX_REQ)
                                    if data is not None:
                                        write_in_dir(dsub, pn, data, mode=0o600, uid=uid, gid=gid)
                                        n += 1
                            finally:
                                os.close(dsub)
                        finally:
                            os.close(sub)
            finally:
                os.close(dst)
        finally:
            os.close(src)
        return n

    def restore(self, args: dict[str, Any]) -> dict[str, Any]:
        """从站点配置的备份目录恢复(恢复要空目录):停站点 → 现在的站点目录挪开 → 恢复 → 带回 VPN 状态
        → 起。恢复不成就挪回去再起。"""
        home, venv, user = self._site()
        hfd = _dir_fd(home)
        try:
            raw = read_in_dir(hfd, "site.json", limit=MAX_REQ)
        finally:
            os.close(hfd)
        cfg = json.loads(raw) if raw else None
        dest = cfg.get("backup_dir") if isinstance(cfg, dict) else None
        if not isinstance(dest, str) or not Path(dest).is_dir():
            raise OpError("站点未配置备份目录")
        aside = home.with_name(f"{home.name}.before-restore-{int(time.time())}")
        self._sys("systemctl", "stop", "d1max-site.service", timeout=180)
        os.rename(home, aside)
        pw = pwd.getpwnam(user)
        try:
            home.mkdir(mode=0o700)
            if os.geteuid() == 0:
                os.chown(home, pw.pw_uid, pw.pw_gid)
            self._sys("runuser", "-u", user, "--", str(venv / "bin" / "d1max-site"), "--home",
                      str(home), "restore", dest, timeout=3600)
            kept = self._keep_vpn(aside, home, pw.pw_uid, pw.pw_gid)
        except Exception:
            shutil.rmtree(home, ignore_errors=True)
            os.rename(aside, home)
            self.run(["systemctl", "start", "d1max-site.service"], 120)
            raise
        self._sys("systemctl", "start", "d1max-site.service", timeout=120)
        return {"aside": str(aside), "vpn_files": kept}

    def _system_files(self) -> list[Path]:
        """站点升级(``install-site.sh --upgrade``)会改到的系统文件、目录(外审 W55-1 第 11 条:回退要连它们
        一起换回去)。"""
        lib = Path(self.cfg.get("lib_dir", "/usr/local/lib/d1max"))
        etc_site = self.etc / "d1max-site"
        return [self.systemd_dir / "d1max-site.service", self.systemd_dir / "d1max-mosquitto.service",
                self.systemd_dir / "d1max-ops.path", self.systemd_dir / "d1max-ops.service",
                lib, self.etc / "d1max-ops.json", etc_site / "release-pub.pem",
                etc_site / "release-pub.d", self.etc / "chrony" / "conf.d" / "d1max-site.conf"]

    def _save_system(self, keep: Path) -> list[tuple[Path, Path | None]]:
        saved: list[tuple[Path, Path | None]] = []
        for i, src in enumerate(self._system_files()):
            if not os.path.lexists(src):
                saved.append((src, None))
                continue
            dst = keep / "sys" / str(i)
            dst.parent.mkdir(parents=True, exist_ok=True)
            if src.is_dir() and not src.is_symlink():
                shutil.copytree(src, dst, symlinks=True)
            else:
                shutil.copy2(src, dst, follow_symlinks=False)
            saved.append((src, dst))
        return saved

    @staticmethod
    def _put_system(saved: list[tuple[Path, Path | None]]) -> None:
        for src, dst in saved:
            if src.is_dir() and not src.is_symlink():
                shutil.rmtree(src)
            elif os.path.lexists(src):
                src.unlink()
            if dst is None:
                continue
            if dst.is_dir() and not dst.is_symlink():
                shutil.copytree(dst, src, symlinks=True)
            else:
                shutil.copy2(dst, src, follow_symlinks=False)

    def _db_save(self, home: Path, keep: Path) -> bool:
        """站点库(站点账号的目录里,可能被换成链接):相对目录描述符、不跟链接读出来。"""
        hfd = _dir_fd(home)
        try:
            data = read_in_dir(hfd, "site.db", limit=64 << 30)
        finally:
            os.close(hfd)
        if data is None:
            return False
        (keep / "site.db").write_bytes(data)
        return True

    def _db_put(self, home: Path, keep: Path, uid: int, gid: int) -> None:
        """库放回去:临时文件 + 原子替换(换掉的是目录项,不沿链接写);WAL、SHM 删掉(unlink 不跟链接)。"""
        hfd = _dir_fd(home)
        try:
            write_in_dir(hfd, "site.db", (keep / "site.db").read_bytes(), mode=0o600,
                         uid=uid, gid=gid)
            for side in ("site.db-wal", "site.db-shm"):
                try:
                    os.unlink(side, dir_fd=hfd)
                except FileNotFoundError:
                    pass
        finally:
            os.close(hfd)

    def update(self, args: dict[str, Any]) -> dict[str, Any]:
        """升级站点:站点放在 ``<site_home>/updates/<包>.tar.gz`` 的包 → 读进内存 → 解进 root 目录 → 删掉签名
        范围以外的 → 验签 → 停站点、留一份程序、库、系统文件 → 装 → 起 → 看 30 秒;不行就全换回去再起、
        再看一遍。换回去也起不来:恢复材料留着,说清楚在哪。"""
        home, venv, user = self._site()
        pkg_name = args.get("package")
        if not isinstance(pkg_name, str) or not PKG_RE.fullmatch(pkg_name):
            raise OpError("升级包名错误")
        pw = pwd.getpwnam(user)
        hfd = _dir_fd(home)
        try:
            ufd = os.open("updates", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=hfd)
        except OSError as exc:
            raise OpError(f"没有升级包目录:{exc}") from exc
        finally:
            os.close(hfd)
        try:
            fd = os.open(pkg_name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=ufd)
        except OSError as exc:
            raise OpError(f"打不开升级包:{exc}") from exc
        finally:
            os.close(ufd)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != pw.pw_uid \
                    or st.st_size > 512 * 1024 * 1024:
                raise OpError("升级包不是站点账号的普通文件,或过大")
            with os.fdopen(fd, "rb", closefd=False) as f:
                raw = f.read()
        finally:
            os.close(fd)
        pubkey = Path(self.cfg.get("site_pubkey", "/etc/d1max-site/release-pub.pem"))
        if not pubkey.is_file():
            raise OpError("站点上没装发行公钥:不升级")
        spool = Path(self.cfg.get("spool", "/var/lib/d1max-ops"))
        work = Path(tempfile.mkdtemp(prefix="d1max-site-update-", dir=spool))
        os.chmod(work, 0o700)
        keep_work = False
        try:
            with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as tar:
                safe_extract(tar, work)
            tops = [p for p in work.iterdir() if p.is_dir()]
            if len(tops) != 1:
                raise OpError("升级包里要正好一个目录")
            pkg = tops[0]
            prune_unsigned(pkg)
            manifest = json.loads((pkg / "release.json").read_text(encoding="utf-8"))
            tree_ok(pkg, manifest, pubkey)
            if not (pkg / "deploy" / "site" / "install-site.sh").is_file():
                raise OpError("这不是站点升级包(没有 deploy/site/install-site.sh)")
            keep = work / "prev"
            keep.mkdir()
            self._sys("systemctl", "stop", "d1max-site.service", timeout=180)
            try:
                shutil.copytree(venv, keep / "venv", symlinks=True)
                had_db = self._db_save(home, keep)
                saved = self._save_system(keep)
            except Exception as exc:
                self.run(["systemctl", "start", "d1max-site.service"], 120)
                raise OpError(f"升级前留底失败,未升级(站点已重新启动):{exc}") from exc
            ok = False
            try:
                self._sys("bash", str(pkg / "deploy" / "site" / "install-site.sh"), "--upgrade",
                          timeout=1800)
                ok = self._healthy(30)
            except OpError:
                ok = False
            if ok:
                return {"version": manifest.get("version"), "rolled_back": False}
            self.run(["systemctl", "stop", "d1max-site.service"], 180)
            try:
                shutil.rmtree(venv, ignore_errors=True)
                shutil.copytree(keep / "venv", venv, symlinks=True)
                if had_db:
                    self._db_put(home, keep, pw.pw_uid, pw.pw_gid)
                self._put_system(saved)
                self.run(["systemctl", "daemon-reload"], 60)
                self.run(["systemctl", "start", "d1max-site.service"], 120)
                back = self._healthy(30)
            except Exception as exc:          # noqa: BLE001 - 换回去出错:材料留着
                back = False
                log_err = str(exc)
            else:
                log_err = ""
            if back:
                raise OpError("新版本未能正常运行,已退回原版本")
            keep_work = True
            raise OpError(f"新版本未能正常运行,退回原版本后站点仍未正常运行{(':' + log_err) if log_err else ''};"
                          f"恢复材料留在 {keep}(venv、site.db、sys/)")
        finally:
            if not keep_work:
                shutil.rmtree(work, ignore_errors=True)

    def vpn_apply(self, args: dict[str, Any]) -> dict[str, Any]:
        """站点给的 VPN 数据(``<site_home>/vpn/apply.json``,结构化:密钥、地址、端口)逐项核过,
        由这里生成 ``/etc/wireguard/d1max.conf``(含固定的转发规则)、生效。请求方给不了命令钩子
        (外审 W55-1 第 1 条)。"""
        home, _, user = self._site()
        pw = pwd.getpwnam(user)
        hfd = _dir_fd(home)
        try:
            vfd = os.open("vpn", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=hfd)
        except OSError as exc:
            raise OpError(f"没有 VPN 目录:{exc}") from exc
        finally:
            os.close(hfd)
        try:
            fd = os.open("apply.json", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=vfd)
        except OSError as exc:
            raise OpError(f"打不开 VPN 数据:{exc}") from exc
        finally:
            os.close(vfd)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != pw.pw_uid or st.st_size > MAX_REQ * 4:
                raise OpError("VPN 数据不是站点账号的普通文件,或过大")
            with os.fdopen(fd, "rb", closefd=False) as f:
                doc = json.loads(f.read())
        except ValueError as exc:
            raise OpError("VPN 数据不是 JSON") from exc
        finally:
            os.close(fd)
        conf = render_wg(check_vpn_doc(doc))
        wg = self.etc / "wireguard"
        wg.mkdir(mode=0o700, parents=True, exist_ok=True)
        write_atomic(wg / "d1max.conf", conf.encode(), mode=0o600)
        rc, _ = self.run(["systemctl", "is-active", "--quiet", "wg-quick@d1max.service"], 30)
        if rc == 0:
            self._sys("systemctl", "restart", "wg-quick@d1max.service")
        else:
            self._sys("systemctl", "enable", "--now", "wg-quick@d1max.service")
        return {"peers": len(doc["peers"])}

    def wg_status(self, args: dict[str, Any]) -> dict[str, Any]:
        rc, out = self.run(["wg", "show", "d1max", "dump"], 30)
        if rc != 0:
            return {"up": False, "peers": []}
        peers = []
        for line in out.splitlines()[1:]:
            f = line.split("\t")
            if len(f) >= 8:
                peers.append({"public_key": f[0], "allowed_ips": f[3],
                              "latest_handshake": int(f[4]) if f[4].isdigit() else 0,
                              "rx": int(f[5]) if f[5].isdigit() else 0,
                              "tx": int(f[6]) if f[6].isdigit() else 0})
        return {"up": True, "peers": peers}


