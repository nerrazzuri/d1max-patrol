#!/bin/sh
# nexwar_sidecar 的启动脚本(工单 7,运动控制旁路 patrol_agent)。单元只指着
# /opt/nexwar/current/deploy/nexwar_sidecar_start,参数归版本管。
#
# 旁路程序要链厂商 SDK,在跑它的那台机器上编。W55 起发布包带源码(motion/),装新版本时
# 用 /etc/nexwar/env 里 NEXWAR_ROBOT_SDK 指的 SDK 编到 <版本>/motion/build/patrol_agent;SDK 不进包。
# 现场值从 /etc/nexwar/env 来(单元的 EnvironmentFile):
#   NEXWAR_SIDECAR_BIN=<程序>            缺省 /home/robot/d1max-motion/patrol_agent
#   NEXWAR_SIDECAR_ROBOT=<IP:端口>        厂家 SDK 的地址,缺省 192.168.168.168:8082(RK3588 有线口)
#   NEXWAR_SIDECAR_LISTEN=<HOST:端口>     代理连它的地址,缺省 127.0.0.1:8090(代理 --sidecar 同一个)
#   NEXWAR_SIDECAR_DIR=<目录>             FIFO、日志放这儿,缺省 ~/nexwar_sidecar
#   NEXWAR_SIDECAR_ARGS=其余参数
#   NEXWAR_OBS_PERMIT=1|0                 站点设置(11-06 不靠 SSH):障碍净空许可门开 / 关;设了就盖过
#                                         ARGS 里手写的 --require-clearance
#   NEXWAR_MAX_FRACTION=0.5|0.7|1.0       站点设置:前进比例上限(放在最后,盖过 ARGS 里手写的)
# 令牌照旧写 ~/.nexwar/sidecar.token(代理的 --sidecar-token-file 缺省同一个)。
set -eu
# W55:升级时在机器人上编好的那个(跟着这一版走)优先;没有再用现场编的老位置
here=$(cd "$(dirname "$0")/.." && pwd -P)
if [ -z "${NEXWAR_SIDECAR_BIN:-}" ] && [ -x "$here/motion/build/patrol_agent" ]; then
  NEXWAR_SIDECAR_BIN="$here/motion/build/patrol_agent"
fi
bin="${NEXWAR_SIDECAR_BIN:-/home/robot/d1max-motion/patrol_agent}"
robot="${NEXWAR_SIDECAR_ROBOT:-192.168.168.168:8082}"
listen="${NEXWAR_SIDECAR_LISTEN:-127.0.0.1:8090}"
dir="${NEXWAR_SIDECAR_DIR:-$HOME/nexwar_sidecar}"
if [ ! -x "$bin" ]; then
  echo "nexwar_sidecar: 没有旁路程序 $bin —— 先在这台机器上编(motion/:make ARCH=aarch64 patrol_agent)," \
       "或者在 /etc/nexwar/env 里给 NEXWAR_SIDECAR_BIN" >&2
  exit 78
fi
case "$robot" in
  *:*) ;;
  *) echo "nexwar_sidecar: NEXWAR_SIDECAR_ROBOT 要写成 IP:端口(现在是 $robot)" >&2; exit 78 ;;
esac
# 2026-10-28:现场手写的单元缺 runs/ 目录,FIFO 建不出来
mkdir -p "$dir/runs"
cd "$dir"
# 站点设置的障碍许可:关了就把手写的 --require-clearance 去掉,开了就加上
args=""
for a in ${NEXWAR_SIDECAR_ARGS:-}; do
  if [ "$a" = "--require-clearance" ] && [ -n "${NEXWAR_OBS_PERMIT:-}" ]; then
    continue
  fi
  args="$args $a"
done
if [ "${NEXWAR_OBS_PERMIT:-}" = 1 ]; then
  args="$args --require-clearance"
fi
if [ -n "${NEXWAR_MAX_FRACTION:-}" ]; then
  args="$args --max-fraction $NEXWAR_MAX_FRACTION"
fi
# shellcheck disable=SC2086  # 参数要按空白拆成几个
exec "$bin" "${robot%:*}" "${robot##*:}" --listen "$listen" --fifo "$dir/runs/nexwar_agent.fifo" \
  $args
