#!/bin/sh
# nexwar_migrate prepare|finish —— 改名迁移(d1max → nexwar,2026-11):已经装好的机器人 / 站点主机上
# 把老名字的目录、配置、单元、账号换成新名字。装机脚本(install.sh、install-site.sh)自己调,人不用单独跑。
#
#   prepare  装新版之前:老的单元记下哪些开着 → 停掉、禁用、删单元文件;配置先打包备份;
#            目录原地改名(mv,不复制:证书、私钥、设备 PIN、地图、发件箱原样搬);env 里的键
#            D1MAX_X 改成 NEXWAR_X、值里的老路径改成新路径(只改不打印);WireGuard 配置改名;
#            站点账号 d1max-site 改名(uid 不变,文件属主跟着走)。
#   finish   新版装完之后:prepare 时开着的单元,按新名字再开起来(装机脚本只开它自己定的那几个,
#            现场手工开过的旁路、雷达合并、WireGuard 不能丢)。
#
# 没有老东西 = 什么都不做(新机器、迁过的机器)。可以重跑。新旧两个目录**都有内容**时不猜、停下(退出 2),
# 让人看一眼。不留老路径的软链接:代码、脚本都只认新路径,软链接还会让卸载、足迹对账多一套名字。
# 测试用:NEXWAR_MIGRATE_ROOT=<假根目录>(账号不改)、NEXWAR_MIGRATE_SYSTEMCTL=<桩>。
set -eu
R=${NEXWAR_MIGRATE_ROOT:-}
SYSTEMCTL=${NEXWAR_MIGRATE_SYSTEMCTL:-systemctl}
USERMOD=${NEXWAR_MIGRATE_USERMOD:-usermod}
GROUPMOD=${NEXWAR_MIGRATE_GROUPMOD:-groupmod}
RECORD="$R/var/backups/nexwar-migrate.enabled"
# 进度标记:prepare 开始改系统之前写、全做完才删。断电以后重跑:有它就把每一步再走一遍(每步都能重跑)。
STATE="$R/var/backups/nexwar-migrate.state"

DIRS="/etc/d1max-site:/etc/nexwar_site /etc/d1max-ops:/etc/nexwar_ops /etc/d1max-console:/etc/nexwar_console
/etc/d1max:/etc/nexwar /opt/d1max-site:/opt/nexwar_site /opt/d1max:/opt/nexwar
/var/lib/d1max-site:/var/lib/nexwar_site /var/lib/d1max-ops:/var/lib/nexwar_ops /var/lib/d1max:/var/lib/nexwar
/usr/local/lib/d1max:/usr/local/lib/nexwar"
FILES="/etc/d1max-ops.json:/etc/nexwar_ops.json /etc/wireguard/d1max.conf:/etc/wireguard/nexwar.conf"
# 新版装机脚本会按新名字重写的:老的直接删
DROP="/etc/sudoers.d/d1max /etc/systemd/timesyncd.conf.d/d1max.conf /etc/chrony/conf.d/d1max.conf
/etc/chrony/conf.d/d1max-site.conf /etc/systemd/journald.conf.d/d1max.conf
/usr/local/sbin/d1max-privileged /usr/local/sbin/d1max-restart-now /usr/local/bin/d1max-site"

say() { printf '  [改名迁移] %s\n' "$*"; }
# d1max-lidar-merge.service → nexwar_lidar_merge.service;wg-quick@d1max → wg-quick@nexwar。
# 单元名里只有最后一个点前面是名字:d1max-lidar-merge.service 的名字部分连字符全换下划线
# 现场手写的单元 d1max-field-X(11-05 C40221:d1max-field-sidecar)→ 版本里的 nexwar_X
newunit() {
  case "$1" in
    wg-quick@d1max*) printf 'wg-quick@nexwar%s' "${1#wg-quick@d1max}" ;;
    d1max-field-*) n=${1#d1max-field-}; printf 'nexwar_%s.%s' "$(printf '%s' "${n%.*}" | tr '-' '_')" "${n##*.}" ;;
    d1max-*) n=${1#d1max-}; printf 'nexwar_%s.%s' "$(printf '%s' "${n%.*}" | tr '-' '_')" "${n##*.}" ;;
    *) printf '%s' "$1" ;;
  esac
}

old_units() {
  for f in "$R"/etc/systemd/system/d1max-*.service "$R"/etc/systemd/system/d1max-*.path \
           "$R"/etc/systemd/system/d1max-*.timer; do
    [ -e "$f" ] && basename "$f"
  done
  [ -e "$R/etc/wireguard/d1max.conf" ] && echo "wg-quick@d1max.service"
  return 0
}

# 老目录是指着新目录的兼容链(11-05:编好的 Super-LIO 库里写死了 /opt/d1max,见 compat_link):不算老东西
compat() {
  [ -L "$1" ] && [ -e "$2" ] && [ "$(readlink -f "$1")" = "$(readlink -f "$2")" ]
}

anything_old() {
  for pair in $DIRS $FILES; do
    old="$R${pair%%:*}"; new="$R${pair#*:}"
    [ -e "$old" ] && ! compat "$old" "$new" && return 0
  done
  for f in $DROP; do [ -e "$R$f" ] && return 0; done
  [ -n "$(old_units)" ] && return 0
  return 1
}

# 配置里的老路径、老话题 → 新的(sed 表达式;先长后短:/etc/d1max-site 先于 /etc/d1max)
SEDX='s/D1MAX_/NEXWAR_/g
s#/etc/d1max-site#/etc/nexwar_site#g;s#/etc/d1max-ops#/etc/nexwar_ops#g
s#/etc/d1max-console#/etc/nexwar_console#g;s#/etc/d1max#/etc/nexwar#g
s#/opt/d1max-site#/opt/nexwar_site#g;s#/opt/d1max#/opt/nexwar#g
s#/var/lib/d1max-site#/var/lib/nexwar_site#g;s#/var/lib/d1max-ops#/var/lib/nexwar_ops#g
s#/var/lib/d1max#/var/lib/nexwar#g;s#/usr/local/lib/d1max#/usr/local/lib/nexwar#g'
# 只换路径(不动键名):编出来的 Super-LIO 工作区用
PATHX=$(printf '%s\n' "$SEDX" | sed '1d')
# 只给配置用:ROS 话题 /d1max/xxx → /nexwar/xxx(老路径上面已经换完,这里剩下的只有话题)
TOPICX='s#/d1max/#/nexwar/#g'

conflicts() {
  for pair in $DIRS; do
    old="$R${pair%%:*}"; new="$R${pair#*:}"
    compat "$old" "$new" && continue
    if [ -e "$old" ] && [ -e "$new" ] && [ -n "$(ls -A "$new" 2>/dev/null)" ]; then echo "$old 和 $new"; fi
  done
  for pair in $FILES; do
    old="$R${pair%%:*}"; new="$R${pair#*:}"
    if [ -e "$old" ] && [ -s "$new" ]; then echo "$old 和 $new"; fi
  done
}

# 配置文件:env、*.conf/json/yaml/toml(/etc 下我们的目录),站点数据目录里的 site.json、broker 配置
config_files() {
  for d in /etc/nexwar /etc/nexwar_site /etc/nexwar_ops /etc/nexwar_console; do
    [ -d "$R$d" ] || continue
    find "$R$d" -type f \( -name env -o -name '*.env' -o -name '*.conf' -o -name '*.json' \
        -o -name '*.yaml' -o -name '*.yml' -o -name '*.toml' \)
  done
  for f in /etc/nexwar_ops.json /var/lib/nexwar_site/site.json; do [ -f "$R$f" ] && echo "$R$f"; done
  [ -d "$R/var/lib/nexwar_site/broker" ] && find "$R/var/lib/nexwar_site/broker" -maxdepth 1 -type f \
      -name '*.conf'
  return 0
}

# 搬过去的程序目录里写死的绝对路径:解释器包装、venv 的脚本头(bin/ 下的文本文件)、pyvenv.cfg、
# 版本槽记的 SuperLIO 位置;指着老位置的软链(current、superlio/current)。老版本槽里的代码不碰
# (不会再跑;版本包按哈希对账)。二进制不碰(grep -I)。
relocate() {
  for d in /opt/nexwar /opt/nexwar_site /var/lib/nexwar /var/lib/nexwar_site; do
    [ -d "$R$d" ] || continue
    find "$R$d" -type l | while read -r l; do
      t=$(readlink "$l")
      n=$(printf '%s\n' "$t" | sed "$SEDX")
      [ "$n" = "$t" ] || ln -sfn "$n" "$l"
    done
  done
  { [ -f "$R/opt/nexwar/bin/python" ] && echo "$R/opt/nexwar/bin/python"
    for v in /opt/nexwar/bin-venv /opt/nexwar_site/venv; do
      [ -d "$R$v" ] && find "$R$v" \( -path '*/bin/*' -o -name pyvenv.cfg \) -type f
    done
    [ -d "$R/opt/nexwar/releases" ] && find "$R/opt/nexwar/releases" -path '*/venv/superlio-root' -type f
  } | while read -r f; do
    grep -qIE '/(opt|etc|var/lib)/d1max' "$f" 2>/dev/null || continue
    sed -i "$SEDX" "$f"
  done
  # 11-05 C40221:编好的 Super-LIO 工作区(colcon 的 setup.sh、*.dsv、cmake 配置)写死编译时的绝对路径,
  # 搬了目录 source 就报「build time path doesn't exist」,定位器起不来。文本文件只换路径,二进制不碰。
  if [ -d "$R/opt/nexwar/superlio" ]; then
    find "$R/opt/nexwar/superlio" -path '*/install/*' -type f -print0 \
      | xargs -0 -r grep -lIE '/(opt|etc|var/lib)/d1max' 2>/dev/null | while read -r f; do
      sed -i "$PATHX" "$f"
    done
  fi
  return 0
}

# 11-05 C40221:现场手写的旁路单元 d1max-field-sidecar(程序、地址、参数都写在 ExecStart 里)迁移时被删,
# 版本里的 nexwar_sidecar 读 /etc/nexwar/env 的 NEXWAR_SIDECAR_*(见 deploy/nexwar_sidecar_start)。
# 删单元之前把它的启动命令拆成这几项记下(落盘,断电重跑不丢),env 搬好以后补进去。
# 跟缺省一样的不写(程序写了会盖住装机时按版本编的那个);--fifo、--token-file 不带(新旧缺省路径代理都认)。
SIDECAR_CARRY="$R/var/backups/nexwar-migrate.sidecar"
SIDECAR_UNIT="$R/etc/systemd/system/d1max-field-sidecar.service"
# 11-05 商场:Super-LIO 把编译时的源码目录编进 liblio.so,地图路径拼在它后面;目录搬了它就载不了图
# (Global ICP 一直失败)。二进制改不了:库里编着 /opt/d1max 的,留一条 /opt/d1max → nexwar 的兼容链,
# 重编(deploy/nexwar_superlio_build)以后就用不着了。
compat_link() {
  [ -d "$R/opt/nexwar/superlio" ] || return 0
  [ -e "$R/opt/d1max" ] || [ -L "$R/opt/d1max" ] && return 0
  find "$R/opt/nexwar/superlio" -name liblio.so -type f 2>/dev/null | while read -r f; do
    if grep -qa '/opt/d1max/' "$f"; then echo y; break; fi
  done | grep -q y || return 0
  ln -s nexwar "$R/opt/d1max"
  say "Super-LIO 库里编着 /opt/d1max:留兼容链 /opt/d1max → /opt/nexwar(重编 Super-LIO 后可删)"
}

sidecar_note() {
  [ -f "$SIDECAR_UNIT" ] || return 0
  [ -f "$SIDECAR_CARRY" ] && return 0
  line=$(sed -n 's/^ExecStart=//p' "$SIDECAR_UNIT" | head -n 1 | sed 's/^[-@+!:]*//')
  set -f
  # shellcheck disable=SC2086  # 按空白拆成几个参数
  set -- $line
  set +f
  if [ "$(basename "${1:-x}")" != patrol_agent ] || [ $# -lt 3 ]; then
    say "警告: 现场旁路单元 d1max-field-sidecar 的启动命令认不出来:迁完手工在 /etc/nexwar/env 里填" \
        "NEXWAR_SIDECAR_BIN / NEXWAR_SIDECAR_ARGS(见 deploy/nexwar_sidecar_start)"
    return 0
  fi
  bin=$1; robot="$2:$3"; shift 3
  listen=""; args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --listen) shift; if [ $# -gt 0 ]; then listen=$1; shift; fi ;;
      --fifo|--token-file) shift; if [ $# -gt 0 ]; then shift; fi ;;
      *) args="${args:+$args }$1"; shift ;;
    esac
  done
  {
    if [ "$bin" != /home/robot/d1max-motion/patrol_agent ]; then echo "NEXWAR_SIDECAR_BIN=$bin"; fi
    if [ "$robot" != 192.168.168.168:8082 ]; then echo "NEXWAR_SIDECAR_ROBOT=$robot"; fi
    if [ -n "$listen" ] && [ "$listen" != 127.0.0.1:8090 ]; then echo "NEXWAR_SIDECAR_LISTEN=$listen"; fi
    if [ -n "$args" ]; then echo "NEXWAR_SIDECAR_ARGS=\"$args\""; fi
  } > "$SIDECAR_CARRY.new"
  mv "$SIDECAR_CARRY.new" "$SIDECAR_CARRY"
}

sidecar_apply() {
  [ -f "$SIDECAR_CARRY" ] || return 0
  env="$R/etc/nexwar/env"
  if [ ! -f "$env" ]; then mkdir -p "$(dirname "$env")"; (umask 077; : > "$env"); fi
  if [ -s "$env" ] && [ -n "$(tail -c 1 "$env")" ]; then echo >> "$env"; fi
  while IFS= read -r kv; do
    [ -n "$kv" ] || continue
    grep -q "^${kv%%=*}=" "$env" || printf '%s\n' "$kv" >> "$env"
  done < "$SIDECAR_CARRY"
  say "现场旁路单元 d1max-field-sidecar 的程序、参数补进 /etc/nexwar/env 的 NEXWAR_SIDECAR_*(已有的不盖)"
  rm -f "$SIDECAR_CARRY"
}

prepare() {
  anything_old || [ -f "$STATE" ] || return 0
  say "这台机器还有改名前(d1max)的东西:换成 nexwar"
  c=$(conflicts)
  if [ -n "$c" ]; then
    printf '%s\n' "$c" | sed 's/^/错误: /;s/$/ 都有内容,不知道该留哪个。看一眼,把不要的那个挪走再装。/' >&2
    exit 2
  fi
  mkdir -p "$R/var/backups"
  echo prepare > "$STATE"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  conf=""
  for p in /etc/d1max /etc/d1max-site /etc/d1max-ops /etc/d1max-console /etc/d1max-ops.json \
           /etc/wireguard/d1max.conf; do
    [ -e "$R$p" ] && conf="$conf ${p#/}"
  done
  if [ -n "$conf" ]; then
    bk="$R/var/backups/nexwar-migrate-$stamp.tar.gz"
    (umask 077; tar -C "$R/" -czf "$bk" $conf)
    say "配置先备份到 ${bk#"$R"}(只有 root 能读;里面有私钥、PIN)"
  fi
  sidecar_note
  # 开着的单元**先记下(落盘)再停**:停到一半断电,重跑时已经停了的查不出原来开着
  for u in $(old_units); do
    if $SYSTEMCTL is-enabled --quiet "$u" 2>/dev/null; then echo "$u" >> "$RECORD"; sync; fi
    $SYSTEMCTL disable --now "$u" >/dev/null 2>&1 || true
  done
  if [ -f "$RECORD" ]; then sort -u "$RECORD" > "$RECORD.new"; mv "$RECORD.new" "$RECORD"; fi
  for f in "$R"/etc/systemd/system/d1max-* "$R"/etc/systemd/system/*.wants/d1max-*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    rm -rf "$f"
  done
  for pair in $DIRS $FILES; do
    old="$R${pair%%:*}"; new="$R${pair#*:}"
    [ -e "$old" ] || continue
    compat "$old" "$new" && continue
    if [ -d "$new" ] && [ -z "$(ls -A "$new")" ]; then rmdir "$new"; fi
    [ -f "$new" ] && [ ! -s "$new" ] && rm -f "$new"
    mkdir -p "$(dirname "$new")"
    mv "$old" "$new"
    say "${old#"$R"} → ${new#"$R"}"
  done
  for f in $DROP; do rm -f "$R$f"; done
  # 证书、私钥不碰;只改键名、路径、话题,值不打印
  config_files | while read -r f; do
      grep -qE 'D1MAX_|/d1max' "$f" 2>/dev/null || continue
      sed -i -e "$SEDX" -e "$TOPICX" "$f"
      say "改了 ${f#"$R"} 里的键名、路径(值不打印)"
  done
  relocate
  compat_link
  sidecar_apply
  if [ -z "$R" ] && id -u d1max-site >/dev/null 2>&1 && ! id -u nexwar_site >/dev/null 2>&1; then
    $USERMOD -l nexwar_site -d /var/lib/nexwar_site d1max-site
    getent group d1max-site >/dev/null 2>&1 && $GROUPMOD -n nexwar_site d1max-site
    say "账号 d1max-site → nexwar_site(uid 不变)"
  fi
  $SYSTEMCTL daemon-reload >/dev/null 2>&1 || true
  rm -f "$STATE"
}

finish() {
  [ -f "$RECORD" ] || return 0
  while read -r u; do
    [ -n "$u" ] || continue
    n=$(newunit "$u")
    case "$n" in wg-quick@*) f="$R/etc/wireguard/${n#wg-quick@}"; f="${f%.service}.conf" ;;
                 *) f="$R/etc/systemd/system/$n" ;; esac
    if [ -e "$f" ]; then
      $SYSTEMCTL enable --now "$n" >/dev/null 2>&1 && say "改名前开着的 $u → 开 $n" \
        || say "警告: $n 开不起来,看 journalctl -u $n"
    else
      say "改名前开着的 $u 这一版没有对应的 $n(跳过)"
    fi
  done < "$RECORD"
  mv "$RECORD" "$RECORD.done-$(date -u +%Y%m%dT%H%M%SZ)"
}

case "${1:-}" in
  prepare) prepare ;;
  finish) finish ;;
  *) echo "用法: nexwar_migrate prepare|finish" >&2; exit 64 ;;
esac
