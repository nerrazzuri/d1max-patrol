[Unit]
Description=D1 Max 运动控制旁路(patrol_agent:经厂家 SDK 握控制权、只收代理的运动命令;工单 7)
# 装机脚本只装、不 enable:旁路跑在哪台机器上(厂商 RK3588、Orin、以后的自带算力板)按角色定,
# 程序要链厂商 SDK、在那台机器上编(motion/Makefile),发布包里不带。起用:先编好,再
# sudo systemctl enable --now nexwar_sidecar。参数在 /etc/nexwar/env(见 nexwar_sidecar_start)。
After=network-online.target
Wants=network-online.target
# 2026-10-28 C40221:现场手写的单元撞了起停次数上限,开机抢控制权的窗口就那几秒 —— 不设上限
StartLimitIntervalSec=0
# W42:正在清机(解绑 = 恢复出厂,半路断电了)就不起,等配网服务清完
ConditionPathExists=!/etc/nexwar/bind/wiping

[Service]
Type=simple
User=robot
EnvironmentFile=-/etc/nexwar/env
ExecStart=/opt/nexwar/current/deploy/nexwar_sidecar_start
Restart=always
RestartSec=2
# 78 = 程序没编出来 / 配置不对:一直重启也没用,等人
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
