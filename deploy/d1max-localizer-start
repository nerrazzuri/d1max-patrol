#!/bin/sh
# d1max-localizer 的启动脚本(W09b,定位器节点)。跟 d1max-agent-start 一个道理:启动参数归版本管,
# 单元只指着 /opt/d1max/current/deploy/d1max-localizer-start。
#
# 定位器跑在 **ROS 的系统 Python** 里(要 rclpy),代码用这个脚本所在那一版带的
# packages/localizer 与 packages/contract(纯 Python,按 PYTHONPATH 找,不进 venv)。它自己把定位程序
# (W68 起是 Super-LIO 的重定位模式,装机时编好在 /opt/d1max/superlio/current)当子进程拉起来,经本机定位桥(代理的 /var/lib/d1max/agent/loc.sock)把位姿交给代理。跟代理同一个账号
# (桥按账号认)。
#
# 现场值从 /etc/d1max/env 来(单元的 EnvironmentFile):
#   D1MAX_LOC_PRIOR=<目录>   代理没给先验目录时(狗按 --map 载的图)用的先验:里面要有 superlio_map.pcd、frames.json
#   D1MAX_LOC_ROS_DOMAIN=24  雷达话题在哪个 ROS domain(W08 过渡期:读厂商的 domain 24)
#   D1MAX_LOC_RMW=rmw_zenoh_cpp  跟厂商那边一样的中间件
#   D1MAX_LOC_ARGS=其余参数(比如 --lidar-topic /front_lidar);好几个就整行带引号:
#     D1MAX_LOC_ARGS="--lidar-topic /d1max/merged_lidar --imu-topic /front_lidar/imu --imu-ypr=-90,0,180"
#     (接 IMU 当转速先验,工单 27;安装角用 d1max-loc imu-axes 从录包核,C40221 是 -90,0,180)
#     --imu-* 只对 --engine mola(工程师手动切回 MOLA)有用。
set -eu
here=$(cd "$(dirname "$0")/.." && pwd -P)
# W68:这一版编的 Super-LIO 在哪(远程升级按版本记,外审 r2 #7);没记的老槽用 current
if [ -z "${D1MAX_SUPERLIO_ROOT:-}" ] && [ -f "$here/venv/superlio-root" ]; then
  D1MAX_SUPERLIO_ROOT=$(cat "$here/venv/superlio-root")
  export D1MAX_SUPERLIO_ROOT
fi
# ROS 的 setup 脚本里有未定义变量,关掉 -u 再 source
set +u
. /opt/ros/humble/setup.sh
# Super-LIO 的工作区(它的库要在 LD_LIBRARY_PATH 上,子进程继承)
slio="${D1MAX_SUPERLIO_ROOT:-/opt/d1max/superlio/current}"
if [ -f "$slio/install/setup.sh" ]; then
  . "$slio/install/setup.sh"
fi
set -u
export ROS_DOMAIN_ID="${D1MAX_LOC_ROS_DOMAIN:-24}"
export RMW_IMPLEMENTATION="${D1MAX_LOC_RMW:-rmw_zenoh_cpp}"
# numpy 的线性代数库(OpenBLAS)缺省开跟核数一样多的线程,一帧里的小矩阵运算用不着(同感知、人员检测)。
# W71:11-03 商场定位器主进程 8 个线程各 10–14%、峰值 256%。Super-LIO 子进程并行用 TBB,不受影响。
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
export PYTHONPATH="$here/packages/localizer/src:$here/packages/contract/src${PYTHONPATH:+:$PYTHONPATH}"
# shellcheck disable=SC2086  # D1MAX_LOC_ARGS 要按空白拆成几个参数
exec /usr/bin/python3 -m d1max_localizer.main \
  --socket /var/lib/d1max/agent/loc.sock \
  ${D1MAX_LOC_PRIOR:+--prior-dir} ${D1MAX_LOC_PRIOR:+"$D1MAX_LOC_PRIOR"} \
  ${D1MAX_LOC_ARGS:-}
