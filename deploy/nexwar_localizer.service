[Unit]
Description=D1 Max 定位器(Super-LIO 定位 + 定位质量,经本机定位桥给代理;W09b、W68)
# 装机脚本只装、不 enable:真狗在 W09b 的真机项验过之前不起(代理也还用 --localizer anchor)。
# 起用:sudo systemctl enable --now nexwar_localizer,再在 /etc/nexwar/env 里写 NEXWAR_LOCALIZER=bridge。
After=network-online.target nexwar_agent.service nexwar_zenohd.service
Wants=network-online.target
StartLimitIntervalSec=0
# W42:正在清机(解绑 = 恢复出厂,半路断电了)就不起,等配网服务清完
ConditionPathExists=!/etc/nexwar/bind/wiping

[Service]
Type=simple
# 跟代理同一个账号:本机定位桥按对端进程的账号认(W09a)。
User=robot
WorkingDirectory=-/opt/nexwar/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nexwar/env
ExecStart=/opt/nexwar/current/deploy/nexwar_localizer_start
# 定位程序(Super-LIO)是它的子进程(同一个进程组以外的子孙也在这个 cgroup 里):停的时候一起停。
KillMode=control-group
# W68:定位是重中之重(用户 2026-11-02)。Super-LIO 缺 CPU 会直接跑飞(11-02 台式机实测),给它高优先级;
# 子进程继承。要不要再绑核等 Orin / RK3588 上实测负载再定。
Nice=-10
CPUWeight=1000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
