[Unit]
Description=D1 Max 巡检服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot
# **指着符号链接,不指任何一版。** 这一行就是双槽能换、能退的全部原因。
#
# **前缀的 '-' 不能省。** current 是一条符号链接,而"它悬空"(指着一版已经
# 被删掉、或者换链换了一半的目录)正是下面 ExecStartPre 那个守卫要修的事。
# 没有 '-' 的话,systemd 进不去工作目录就直接判整个启动失败 —— 守卫连跑都
# 跑不起来,而它本来就是为这种坏法准备的。安全网不该比它防的问题更危险。
WorkingDirectory=-/opt/d1max/current
Environment=D1MAX_RELEASE_ROOT=/opt/d1max
Environment=PYTHONUNBUFFERED=1
# D1MAX_SN 从这份文件来。前缀的 '-' 是"文件不在也别拦启动" —— 装机第一次
# 起服务时人可能还没来得及填 SN,不能让服务因此起不来。命令行 release
# activate 记进 pending.json 的 SN 跟这里解析出来的必须是同一个来源,
# 否则重启后自检第四项(identity)会假失败,把一版好的自动回滚掉。
# install.sh 第 7 步自己也读这同一份文件,再把 D1MAX_SN 显式传给
# release activate —— "同一个来源"是靠那两处一起成立的。
# **它那边是照着 systemd 的字面量规矩解析的,不是 source。** 这份文件由现场
# 用 nano 手填,`D1MAX_SN=C4 0221`、`TOKEN=a;reboot` 这种值 systemd 原样收下,
# 而 shell 会去分词、去执行 —— 两边读出不同的值是自检假失败的来源,
# 更别说以 root 跑一段人手敲错的字符串。改 install.sh 那段解析的人请一起看这里。
EnvironmentFile=-/etc/d1max/env
# 版本守卫。**它必须在每一次服务启动时数一次,不只是真开机那一次。**
#
# 这里原来是一个独立的 d1max-bootguard.service(oneshot +
# WantedBy=multi-user.target),那意味着守卫只在真开机时跑。而不带上装的
# 机器 —— 也就是交付的默认形态 —— 升级走的是 systemctl restart
# d1max-patrol(见 engine/selfcheck.py 的 restart_plan()),根本不开机:
# 守卫不重跑,pending.attempts 永远停在 0,于是新版坏到起不来时,第一层
# (app/server.py 的 _boot_postcheck)跑不到、第二层不触发、Restart=always
# 无限刷,机器躺着等人按电源。而 §7.1 给这一列的承诺是"自检没过就自动
# 回滚,服务再起一次"。engine/release.py 里 boot_guard() 的 docstring 写的
# 本来就是"由 systemd 的 ExecStartPre 调" —— 按它做恰好补上这个洞。
#
# 挂成 ExecStartPre 之后,Restart=always 的每一次重试也会重跑守卫,所以一个
# 起来就崩的版本大约 10 秒内(两次 RestartSec=5)就会被退回上一版。这正是
# 我们要的。**两个单元不能都留着**:真开机时守卫会被数两次,attempts 一次
# 开机加二,第二次开机就把一版本来健康的退掉,比原来那个洞更危险。
#
# **前缀的 '-' 不能省。** 没有它的话,/opt/d1max/bin/python 缺失或损坏
# (正是守卫本该兜底的那种坏法)会让 ExecStartPre 失败并中止整个服务启动
# —— 那就是我们刚用 Wants= 替掉 Requires= 修掉的那个陷阱,换个地方重犯。
# 守卫自己挂了也放行,原来那条 SuccessExitStatus=0 1 的活现在归这个 '-'。
#
# **这个 python 是根下的,不是 current 下的** —— 守卫必须跟版本无关:
# 一个坏到解释器都装歪了的版本,不该把自己的救生索也带坏。
ExecStartPre=-/opt/d1max/bin/python -m d1max_patrol.cli release boot-guard
# 任务包守卫。**跟上面那个是两回事,两条都要。** 上面那个管的是版本目录
# (/opt/d1max/releases + current 链),这一个管的是任务包(/opt/d1max/bundles
# 底下的 current/previous 两条链)。
#
# apply 一个任务包要连着换两条链,两次之间断电盘上就停在 current == previous
# 且 proven=False —— 自动回退判据随即成立,把盘上唯一那份好包拉黑,而路由
# 那头它就再也装不回去了。engine/bundle.py 的 guard_bundle() 是那条局面唯一
# 的出路,而它得有人调:写好了没人调等于没写(评审复评 finding 4),
# 而 docs/任务包格式.md 已经对客户写着"开机时照着它把链修回一个能用的样子"。
#
# 它顺带把从老版本升上来的那份 landed.json 归一化一次(截掉过长的回退历史、
# 把拉黑事实固化下来),所以升级上来的机器开一次机就正常了。
#
# 前缀的 '-' 同上,一个字都不能省;守卫自己永远退 0,理由见 cli.py 的
# _cmd_bundle_guard() docstring。用的同样是根下那个跟版本无关的解释器。
ExecStartPre=-/opt/d1max/bin/python -m d1max_patrol.cli bundle guard
# **这一版自己的 venv,不是根下共享的解释器。** 装机脚本会在把包落进这个
# 槽之后,当场给这个槽建一份自己的 venv —— 双槽的意义之一就是回滚要把
# 依赖也一并退回去,共用解释器的话回滚只退代码不退依赖,退了也白退。
# 真正的 HTTP 服务入口是 app/server.py 的 main()(pyproject.toml 里注册成
# d1max-app);cli.py 的 build_parser() 里没有 serve 这个子命令,指着一个
# 不存在的子命令的话服务每次起来都会 SystemExit 2,Restart=always 会把它
# 刷成每 5 秒一条日志。
#
# **--host 0.0.0.0 不能省。** server.py 的 DEFAULT_HOST 是 127.0.0.1,而
# _build_parser() 里 --host 没有环境变量兜底(只有 --pin/--sn/--nickname
# 有),不写在这一行上就没有第二个地方能把它改掉。手机 app 连的是
# 192.168.168.100:8095,只听 127.0.0.1 的机器它根本连不上 —— 那台机器上
# 手机连不上、三条验收命令全 connection refused、上装属性永远记不上,
# 于是这台机器永远不许升级。
#
# **这一行跟 /etc/d1max/env 里的 D1MAX_PIN 是一对,拆不开。** check_exposure()
# (server.py)见到非本机地址而没有 PIN 会直接 SystemExit 拒绝启动;配上下面
# 的 Restart=always + RestartSec=5,就是每 5 秒刷一条日志的启动循环。所以
# install.sh 第一次写 /etc/d1max/env 时会当场随机生成一个 PIN 填进去,并且
# 在 restart 之前检查它非空,空就 exit 3 停下来喊,不去 restart。
ExecStart=/opt/d1max/current/venv/bin/python -m d1max_patrol.app.server --host 0.0.0.0
# 起不来就再试。**RestartSec 不能是 0**:一个起来就崩的版本会在日志里刷成
# 一堵墙,把真正的错因冲掉,顺便烧掉写盘寿命。5 秒同时也是上面那段"大约
# 10 秒内退回上一版"的来源 —— 守卫要数满 MAX_BOOT_ATTEMPTS(2)次。
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
