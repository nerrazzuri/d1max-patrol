[Unit]
Description=D1 Max 巡检服务
# 守卫先跑完。它决定了 current 指向哪一版 —— 我们得在它定好之后才启动。
After=network-online.target d1max-bootguard.service
Wants=network-online.target
# **是 Wants=,不是 Requires=。** systemd.unit(5):跟顺序依赖(After=)同时
# 存在时,Requires= 会在被依赖单元"没有成功激活"时连带不启动本单元。守卫
# 是 Type=oneshot,只有以 SuccessExitStatus 里的码退出才算激活成功——而
# "/opt/d1max/bin/python 缺失或损坏"这种真机会发生的坏法,恰恰是守卫本该
# 兜底、而不是自己也 failed 的场景。用 Requires= 的话,守卫一 failed,
# 主服务跟着起不来,机器连网页都开不出来,比"守卫没兜住、跑在旧版上"
# 更糟——没有服务严格地更坏。顺序依然由 After= 单独保证,跟这一行无关。
Wants=d1max-bootguard.service

[Service]
Type=simple
User=robot
# **指着符号链接,不指任何一版。** 这一行就是双槽能换、能退的全部原因。
WorkingDirectory=/opt/d1max/current
Environment=D1MAX_RELEASE_ROOT=/opt/d1max
Environment=PYTHONUNBUFFERED=1
# D1MAX_SN 从这份文件来。前缀的 '-' 是"文件不在也别拦启动" —— 装机第一次
# 起服务时人可能还没来得及填 SN,不能让服务因此起不来。命令行 release
# activate 记进 pending.json 的 SN 跟这里解析出来的必须是同一个来源,
# 否则重启后自检第四项(identity)会假失败,把一版好的自动回滚掉。
EnvironmentFile=-/etc/d1max/env
# **这一版自己的 venv,不是根下共享的解释器。** 装机脚本会在把包落进这个
# 槽之后,当场给这个槽建一份自己的 venv —— 双槽的意义之一就是回滚要把
# 依赖也一并退回去,共用解释器的话回滚只退代码不退依赖,退了也白退。
# 真正的 HTTP 服务入口是 app/server.py 的 main()(pyproject.toml 里注册成
# d1max-app);cli.py 的 build_parser() 里没有 serve 这个子命令,指着一个
# 不存在的子命令的话服务每次起来都会 SystemExit 2,Restart=always 会把它
# 刷成每 5 秒一条日志。
ExecStart=/opt/d1max/current/venv/bin/python -m d1max_patrol.app.server
# 起不来就再试。**RestartSec 不能是 0**:一个起来就崩的版本会在日志里刷成
# 一堵墙,把真正的错因冲掉,顺便烧掉写盘寿命。
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
