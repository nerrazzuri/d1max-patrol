[Unit]
Description=D1 Max 感知节点(雷达 → 狗身系局部栅格,经本机障碍桥给代理;净空许可给旁路进程;W11)
# 装机脚本只装、不 enable:真狗在 W11 的真机项验过之前不起(代理也还用 --obstacles none)。
# 起用:sudo systemctl enable --now nexwar_obstacles,再在 /etc/nexwar/env 里写 NEXWAR_OBSTACLES=bridge。
After=network-online.target nexwar_agent.service nexwar_zenohd.service
Wants=network-online.target
StartLimitIntervalSec=0
# W42:正在清机(解绑 = 恢复出厂,半路断电了)就不起,等配网服务清完
ConditionPathExists=!/etc/nexwar/bind/wiping

[Service]
Type=simple
# 跟代理同一个账号:本机障碍桥按对端进程的账号认(W11,同定位桥)。
User=robot
WorkingDirectory=-/opt/nexwar/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nexwar/env
ExecStart=/opt/nexwar/current/deploy/nexwar_obstacles_start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
