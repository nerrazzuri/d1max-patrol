[Unit]
Description=D1 Max 前后雷达合并(后雷达换进前雷达系、拼成 /d1max/merged_lidar 给定位器、建图预览;W09i)
# 装机脚本只装、不 enable:后雷达外参(/etc/d1max/lidars.json)在真机上标过、W09i 的真机项验过之前不起。
# 起用:sudo systemctl enable --now d1max-lidar-merge,再在 /etc/d1max/env 里给定位器
# D1MAX_LOC_ARGS=--lidar-topic /d1max/merged_lidar。外参没标过它只转发前雷达(不拼)。
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=robot
WorkingDirectory=-/opt/d1max/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/d1max/env
ExecStart=/opt/d1max/current/deploy/d1max-lidar-merge-start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
