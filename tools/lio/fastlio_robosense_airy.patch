+// RoboSense Airy 原生 handler：直接读 Airy 点云，per-point 绝对秒 timestamp
+// → 相对帧头的 ms（FAST-LIO 的 curvature 单位是 ms）。绕开 Python rs2velo。
+void Preprocess::robosense_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  pl_surf.clear();
+  pl_corn.clear();
+  pl_full.clear();
+
+  pcl::PointCloud<robosense_ros::Point> pl_orig;
+  pcl::fromROSMsg(*msg, pl_orig);
+  int plsize = pl_orig.points.size();
+  if (plsize == 0)
+    return;
+  pl_surf.reserve(plsize);
+
+  // 帧头时刻 = 第一个点的绝对时戳（RS-Airy 的 header.stamp 与之一致）
+  double t0 = pl_orig.points[0].timestamp;
+  // 若首点异常，回退到全帧最小时戳
+  for (int i = 1; i < plsize; i++)
+    if (pl_orig.points[i].timestamp < t0) t0 = pl_orig.points[i].timestamp;
+
+  const double blind_sqr = blind * blind;
+  for (int i = 0; i < plsize; i++)
+  {
+    if (i % point_filter_num != 0)
+      continue;
+    const auto &p = pl_orig.points[i];
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z))
+      continue;
+    double range_sqr = p.x * p.x + p.y * p.y + p.z * p.z;
+    if (range_sqr < blind_sqr)   // 滤掉机身/腿等近处
+      continue;
+
+    PointType added_pt;
+    added_pt.normal_x = 0;
+    added_pt.normal_y = 0;
+    added_pt.normal_z = 0;
+    added_pt.x = p.x;
+    added_pt.y = p.y;
+    added_pt.z = p.z;
+    added_pt.intensity = p.intensity;
+    // per-point 相对时间，单位 ms（(绝对秒 - 帧头秒) * 1000）
+    added_pt.curvature = static_cast<float>((p.timestamp - t0) * 1000.0);
+    pl_surf.points.push_back(added_pt);
+  }
+}
