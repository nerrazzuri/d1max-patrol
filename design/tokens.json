{
  "$doc": "D1 Max visual tokens — Pro control-room direction (B0 rev. 2026-10-11). Single source for the web duty console and the apps. Spec: docs/视觉规范.md. Neutral grey; colour only for alarms (ISA-101) and selection. Dark theme only.",
  "version": 2,
  "color": {
    "well": "#000000",
    "bg": "#1C1D1F",
    "surface": "#252628",
    "raised": "#303134",
    "rule": "#3C3D40",
    "hatch": "#2C2D30",
    "borderControl": "#85878C",
    "text": "#E2E2E2",
    "textSecondary": "#C0C0C0",
    "textMuted": "#A0A0A0",
    "textDisabled": "#6A6A6A",
    "primary": "#E2E2E2",
    "onPrimary": "#1C1D1F",
    "onSolid": "#FFFFFF",
    "select": "#8FBAF5",
    "selectBg": "#18273D",
    "p1": "#C42B2B",
    "p1Text": "#FF8073",
    "p1Frame": "#FF5A4C",
    "p1Bg": "#3A1618",
    "p1Soft": "#FFC9C2",
    "p2": "#EDB443",
    "p2Bg": "#33290F",
    "noGo": "#3A1C20",
    "noGoBorder": "#AD4A52",
    "noGoText": "#C77B80"
  },
  "overlay": {
    "osdPlate": "rgba(0,0,0,0.7)",
    "osdPlateWorst": "#4D4D4D",
    "pausedDim": 0.5
  },
  "priority": {
    "$doc": "Triple encoding: colour + shape + text. Only unacknowledged P1 flashes; only P2 can be shelved; P3 never enters the alarm queue.",
    "P1": {"color": "p1Text", "solid": "p1", "frame": "p1Frame", "shape": "diamond", "flashUnacked": true, "shelvable": false},
    "P2": {"color": "p2", "solid": "p2", "shape": "triangle", "flashUnacked": false, "shelvable": true},
    "P3": {"color": "textMuted", "shape": "circle-outline", "inQueue": false}
  },
  "robotState": {
    "$doc": "Normal states are neutral (no colour). Only abnormal states use alarm colours, always with a shape and a label.",
    "patrolling": "text",
    "returning": "text",
    "charging": "text",
    "idle": "text",
    "manual": "text",
    "deterring": "p1Text",
    "estop": "p1Text",
    "fell": "p1Text",
    "offline": "p2"
  },
  "modeState": {"armed": "text", "home": "text", "visitor": "text"},
  "font": {
    "sans": "'Atkinson Hyperlegible Next', 'Noto Sans SC', 'Microsoft YaHei UI', 'PingFang SC', system-ui, sans-serif",
    "mono": "'Atkinson Hyperlegible Mono', 'Noto Sans SC', 'Microsoft YaHei UI', ui-monospace, monospace"
  },
  "type": {
    "osd": {"size": 14, "line": 18, "weight": 600, "family": "mono"},
    "caption": {"size": 14, "line": 20, "weight": 400},
    "label": {"size": 14, "line": 20, "weight": 600},
    "body": {"size": 16, "line": 24, "weight": 400},
    "heading": {"size": 18, "line": 24, "weight": 600},
    "unitId": {"size": 18, "line": 24, "weight": 700},
    "title": {"size": 21, "line": 28, "weight": 700},
    "clock": {"size": 21, "line": 28, "weight": 600, "family": "mono"},
    "phoneTitle": {"size": 24, "line": 30, "weight": 700}
  },
  "space": [0, 2, 4, 8, 12, 16, 24, 32],
  "radius": {"video": 0, "unit": 4, "control": 4, "dialog": 8},
  "size": {
    "touch": 44, "button": 40, "buttonPhone": 52, "topbar": 56, "jumpStrip": 40, "unitStrip": 32,
    "unitOffline": 48, "alarmHeader": 40, "alarmActions": 56, "alarmFrame": 3, "alarmFrameReduced": 4,
    "queueOpen": 168, "queueClosed": 40, "unitMinWidth": 640, "gutter": 16, "stopAllRing": 2
  },
  "motion": {
    "fast": 120, "p1FlashMs": 1600, "p1FlashUntil": "acknowledged", "p1FlashMinOpacity": 0.4,
    "pauseAfterHiddenMs": 2000, "visibleThreshold": 0.25
  },
  "contrast": {
    "$doc": "Pairs the UI actually uses; tests/test_design_tokens.py checks each against WCAG AA (body 4.5, non-text 3.0). p1 on bg is 2.99 — Stop all passes via its 2px p1Frame ring, so p1 is not listed against bg.",
    "body": [
      ["text", "bg"], ["text", "surface"], ["text", "raised"], ["text", "p1Bg"], ["text", "p2Bg"],
      ["text", "hatch"], ["text", "well"], ["onPrimary", "primary"], ["textSecondary", "surface"],
      ["textSecondary", "raised"], ["textMuted", "bg"], ["textMuted", "surface"], ["textMuted", "raised"],
      ["textMuted", "hatch"], ["textMuted", "well"], ["textMuted", "p1Bg"], ["onSolid", "p1"],
      ["p1Text", "bg"], ["p1Text", "surface"], ["p1Text", "p1Bg"], ["p1Soft", "p1Bg"], ["p2", "bg"],
      ["p2", "surface"], ["p2", "p2Bg"], ["p2", "hatch"], ["p2", "osdPlateWorst"], ["select", "bg"],
      ["select", "surface"], ["select", "selectBg"], ["onSolid", "osdPlateWorst"], ["noGoText", "noGo"]
    ],
    "nonText": [
      ["borderControl", "bg"], ["borderControl", "surface"], ["borderControl", "raised"], ["p1Frame", "bg"],
      ["p1Frame", "surface"], ["p1Frame", "well"], ["p2", "bg"], ["p2", "well"], ["select", "bg"],
      ["select", "well"], ["noGoBorder", "well"]
    ]
  }
}
