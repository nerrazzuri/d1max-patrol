{
  "$doc": "D1 Max visual tokens (B0, 2026-10-11). Single source for the web duty console and the apps. Spec: docs/视觉规范.md. Dark theme only for now.",
  "version": 1,
  "color": {
    "bg": "#0B0E13",
    "rail": "#0E131A",
    "surface": "#121821",
    "surfaceRaised": "#16202B",
    "mapGround": "#0F151D",
    "mapPlot": "#0B1017",
    "border": "#1A212B",
    "borderStrong": "#2C3644",
    "borderControl": "#5E6E82",
    "text": "#E6EBF2",
    "textSecondary": "#B8C0CC",
    "textMuted": "#8B95A5",
    "textDisabled": "#5B6676",
    "accent": "#3DD68C",
    "accentBg": "#10241A",
    "onAccent": "#0B0E13",
    "info": "#7CC4FF",
    "infoBg": "#12233A",
    "p1": "#D13438",
    "p1Text": "#FF6B5E",
    "p1Bg": "#1A0F11",
    "p1Border": "#5C1E22",
    "p1Soft": "#F2B8B2",
    "p2": "#F5B83D",
    "p2Bg": "#3A2A10",
    "p3": "#8B95A5",
    "noGo": "#3A1C20",
    "noGoBorder": "#7A2A30",
    "noGoText": "#C77B80",
    "route": "#5E6E82",
    "onSolid": "#FFFFFF"
  },
  "robotState": {
    "$doc": "Robot status chip: dot color + label. Never color alone; the label is always shown.",
    "patrolling": "accent",
    "deterring": "p1Text",
    "returning": "info",
    "charging": "info",
    "idle": "textMuted",
    "manual": "p2",
    "estop": "p1Text",
    "offline": "textDisabled"
  },
  "font": {
    "sans": "'IBM Plex Sans', 'Noto Sans SC', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', 'Noto Sans SC', ui-monospace, monospace",
    "zhFallback": "Noto Sans SC"
  },
  "type": {
    "display": {"size": 24, "weight": 700, "line": 32},
    "title": {"size": 18, "weight": 700, "line": 26},
    "heading": {"size": 15, "weight": 700, "line": 22},
    "body": {"size": 14, "weight": 400, "line": 21},
    "label": {"size": 13, "weight": 600, "line": 18},
    "caption": {"size": 12, "weight": 400, "line": 17},
    "overline": {"size": 12, "weight": 600, "line": 16, "tracking": 0.06, "case": "upper"},
    "metric": {"size": 30, "weight": 600, "line": 34, "family": "mono"},
    "clock": {"size": 22, "weight": 600, "line": 28, "family": "mono"}
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48],
  "radius": {"sm": 6, "md": 10, "lg": 14, "xl": 18, "pill": 999},
  "size": {"touch": 44, "button": 40, "buttonPhone": 52, "rail": 80, "railItem": 56},
  "elevation": {"floating": "0 8px 28px rgba(0,0,0,0.45)"},
  "motion": {"fast": 120, "base": 200, "p1PulseMs": 1600},
  "contrast": {
    "$doc": "Pairs the UI actually uses; tests/test_design_tokens.py checks each against WCAG AA (body 4.5, large/bold-14+ and non-text 3.0).",
    "body": [
      ["text", "bg"], ["text", "surface"], ["text", "surfaceRaised"], ["text", "borderStrong"],
      ["textSecondary", "surface"], ["textMuted", "bg"], ["textMuted", "surface"], ["textMuted", "rail"],
      ["onSolid", "p1"], ["p1Text", "bg"], ["p1Text", "p1Bg"], ["p1Soft", "p1Bg"],
      ["accent", "bg"], ["accent", "accentBg"], ["onAccent", "accent"],
      ["info", "infoBg"], ["info", "bg"], ["p2", "surface"], ["p2", "p2Bg"],
      ["noGoText", "noGo"]
    ],
    "nonText": [
      ["accent", "mapPlot"], ["info", "mapPlot"], ["p1Text", "mapPlot"], ["route", "mapPlot"],
      ["borderControl", "bg"], ["borderControl", "surface"]
    ]
  }
}
