  "usage": {
    "$doc": "Which tone a state may use. Red (error) only for P1, e-stop, offline and destructive actions; orange (warning) only for P2 and low battery; green (success) for normal states (user decision 2026-10-14). Priority is always colour + shape + text.",
    "p1": "error",
    "estop": "error",
    "offline": "error",
    "destructive": "error",
    "p2": "warning",
    "lowBattery": "warning",
    "online": "success",
    "connected": "success",
    "battery": "success",
    "synced": "success",
    "ok": "success",
    "p3": "neutral",
    "idle": "neutral",
    "info": "info"
  },
